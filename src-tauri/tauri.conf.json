{
  "$schema": "https://raw.githubusercontent.com/nicbarker/tauri-v2-json-schema/main/schema.json",
  "productName": "TKA Composer",
  "version": "0.1.0",
  "identifier": "com.tkaflowarts.composer.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev -- --port 5174",
    "beforeBuildCommand": "cross-env DISABLE_PWA=true pnpm build",
    "devUrl": "http://localhost:5174",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "TKA Composer",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": true,
        "resizable": true,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
