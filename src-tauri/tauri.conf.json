{
  "$schema": "https://raw.githubusercontent.com/nicbarker/tauri-v2-json-schema/main/schema.json",
  "productName": "Flow Arts Composer",
  "version": "../package.json",
  "identifier": "com.tkaflowarts.composer.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev -- --port 5174",
    "beforeBuildCommand": "node scripts/tauri-build-frontend.cjs",
    "devUrl": "http://localhost:5174",
    "frontendDist": "../.svelte-kit/cloudflare"
  },
  "app": {
    "windows": [
      {
        "title": "Flow Arts Composer",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": true,
        "resizable": true,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../data/sequences/": "data/sequences/"
    },
    "createUpdaterArtifacts": true,
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU3Nzg3MzQzQzcyN0FGMUMKUldRY3J5ZkhRM040VndTYklDV1o2RjZqaW5VWVdWOG1OSnhDL3ZUT2lRSExnWEQ5ZVRLZ2U1U1cK",
      "endpoints": [
        "https://github.com/austencloud/tka-platform/releases/latest/download/latest.json"
      ]
    }
  }
}
