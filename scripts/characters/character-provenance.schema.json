{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tkaflowarts.com/schemas/character-provenance-v1.json",
  "title": "Flow Arts Composer character provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "displayName",
    "source",
    "license",
    "rights",
    "evidence",
    "acquiredAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "displayName": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "assetName", "url"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "assetName": { "type": "string", "minLength": 1 },
        "assetId": { "type": "string" },
        "creator": { "type": "string" },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "spdx": { "type": "string" },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commercialUse",
        "applicationRuntimeDistribution",
        "rawSourceRedistribution",
        "attributionRequired"
      ],
      "properties": {
        "commercialUse": { "enum": ["allowed", "forbidden", "unknown"] },
        "applicationRuntimeDistribution": {
          "enum": ["allowed", "forbidden", "unknown"]
        },
        "rawSourceRedistribution": {
          "enum": ["allowed", "forbidden", "unknown", "not-addressed"]
        },
        "attributionRequired": { "type": "boolean" },
        "creditLine": { "type": "string" },
        "restrictions": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "retrievedAt", "note"],
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "retrievedAt": { "type": "string", "format": "date" },
          "note": { "type": "string", "minLength": 1 }
        }
      }
    },
    "acquiredAt": { "type": "string", "format": "date-time" }
  }
}
