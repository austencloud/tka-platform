{
  "name": "@tka/sequence-engine",
  "version": "0.1.0",
  "description": "Platform-agnostic sequence engine for TKA letter transitions, bridge finding, and orientation propagation.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./core": {
      "types": "./src/core/index.ts",
      "default": "./src/core/index.ts"
    },
    "./generation": {
      "types": "./src/generation/index.ts",
      "default": "./src/generation/index.ts"
    },
    "./loop": {
      "types": "./src/loop/index.ts",
      "default": "./src/loop/index.ts"
    },
    "./analysis": {
      "types": "./src/analysis/index.ts",
      "default": "./src/analysis/index.ts"
    },
    "./harness": {
      "types": "./src/harness/index.ts",
      "default": "./src/harness/index.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "@tka/tka-types": "workspace:*"
  },
  "devDependencies": {
    "rimraf": "^5.0.0",
    "typescript": "^5.0.0"
  },
  "author": "Austen Cloud <austencloud@gmail.com>",
  "license": "MIT"
}
