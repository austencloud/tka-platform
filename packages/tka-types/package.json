{
  "name": "@tka/tka-types",
  "version": "0.1.0",
  "description": "Canonical TKA sequence types — Step, Motion, and enums shared across engine, domain, app, and MCP.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./step": {
      "types": "./src/step.ts",
      "import": "./dist/step.js",
      "default": "./dist/step.js"
    },
    "./motion": {
      "types": "./src/motion.ts",
      "import": "./dist/motion.js",
      "default": "./dist/motion.js"
    },
    "./letter": {
      "types": "./src/letter.ts",
      "import": "./dist/letter.js",
      "default": "./dist/letter.js"
    },
    "./grid": {
      "types": "./src/grid.ts",
      "import": "./dist/grid.js",
      "default": "./dist/grid.js"
    },
    "./motion-type": {
      "types": "./src/motion-type.ts",
      "import": "./dist/motion-type.js",
      "default": "./dist/motion-type.js"
    },
    "./rotation-direction": {
      "types": "./src/rotation-direction.ts",
      "import": "./dist/rotation-direction.js",
      "default": "./dist/rotation-direction.js"
    },
    "./orientation": {
      "types": "./src/orientation.ts",
      "import": "./dist/orientation.js",
      "default": "./dist/orientation.js"
    },
    "./plane": {
      "types": "./src/plane.ts",
      "import": "./dist/plane.js",
      "default": "./dist/plane.js"
    },
    "./hand-side": {
      "types": "./src/hand-side.ts",
      "import": "./dist/hand-side.js",
      "default": "./dist/hand-side.js"
    },
    "./builders": {
      "types": "./src/builders.ts",
      "import": "./dist/builders.js",
      "default": "./dist/builders.js"
    },
    "./guards": {
      "types": "./src/guards.ts",
      "import": "./dist/guards.js",
      "default": "./dist/guards.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "test": "vitest run",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "devDependencies": {
    "rimraf": "^5.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.16"
  },
  "author": "Austen Cloud <austencloud@gmail.com>",
  "license": "MIT"
}
