{
  "name": "@tka/render-core",
  "version": "0.1.0",
  "description": "Pure TypeScript calculation module for TKA pictograph rendering. Shared between browser and Node.js.",
  "type": "module",
  "svelte": "./src/index.ts",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rimraf --glob \"src/**/*.js\" \"src/**/*.d.ts\" && tsc",
    "clean": "rimraf --glob dist tsconfig.tsbuildinfo \"src/**/*.js\" \"src/**/*.d.ts\"",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "devDependencies": {
    "rimraf": "^5.0.0",
    "typescript": "^5.0.0"
  },
  "author": "Austen Cloud <austencloud@gmail.com>",
  "license": "MIT"
}
