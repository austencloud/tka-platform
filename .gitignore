
# Dependencies
node_modules/
.pnpm-debug.log*

# Build and deployment artifacts
# 🚨 CRITICAL: Use /build NOT **/build/** or build/
# The leading slash (/) ensures we only ignore the root-level build output directory,
# NOT source code directories like src/lib/modules/build/ which contain components!
# Without the leading slash, git would ignore ALL directories named "build" at any depth.
/build                          # Ignore ONLY root-level build directory (SvelteKit output)
/build/**
.netlify/
dist/
dev-dist/                       # Vite PWA dev mode output
.output/
/_app/

# Environment files
.env
.env.local
.env.production.local
.env.*.local

# Firebase service account keys (NEVER commit these!)
serviceAccountKey.json
*-firebase-adminsdk-*.json

# YouTube cookies (NEVER commit these!)
youtube-cookies.txt
*cookies*.txt

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# nyc test coverage
.nyc_output

# Test results
test-results/
.playwright-mcp/

# VSCode
.vscode/
.vscode/chrome-debug-fresh/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
nul

# Temporary files
*.tmp
*.temp
.cache/

# SvelteKit
.svelte-kit/

# TypeScript
.tsbuildinfo

# Package manager lock files (keep your preferred one, remove others)
# yarn.lock
# pnpm-lock.yaml
# package-lock.json

# Generated thumbnail cache
static/Explore_thumbnails/

# Generated Explore manifest (auto-generated during build)
static/Explore-manifest.json

# Store assets (screenshots, promotional images)
static/store-assets/

*storybook.log
storybook-static

# Linting reports
eslint-report.json

# TypeScript error output files
typescript-errors*.txt
tsc-output*.txt
filtered-errors.txt
remaining-create-errors.txt
parse-errors.py

# Motion primitives (generated, do not commit)
src/lib/data/motion-primitives.json

# Feedback images (downloaded for review, not committed)
feedback-images/
test-image.png
find-image-feedback.js

# Local mobile dev config (contains network info)
mobile-dev.ps1

# Monolith refactor claims (local multi-agent coordination)
.monolith-claims.json

# Large branding files
static/branding/*.pdf

# Android signing (NEVER commit these!)
keystore.properties
*.jks
*.keystore
android-twa/local.properties
android-twa/keystore.properties

# Screenshot capture credentials
scripts/screenshot-capture/screenshot-config.local.json
