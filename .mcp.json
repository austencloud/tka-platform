{
  "$schema": "https://modelcontextprotocol.io/schema/2025-06-18.json",
  "mcpServers": {
    "playwright": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@playwright/mcp@latest"],
      "env": {}
    },
    "memory": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@modelcontextprotocol/server-memory"],
      "env": {}
    },
    "tka-domain": {
      "command": "cmd",
      "args": [
        "/c",
        "cd /d F:\\tka-platform\\mcp-server && npx -y tsx index.ts"
      ],
      "env": {}
    },
    "game-controller": {
      "command": "node",
      "args": [
        "F:\\tka-platform\\packages\\mcp-game-controller\\dist\\index.js"
      ],
      "env": {
        "GAME_WS_PORT": "9876"
      }
    }
  }
}
