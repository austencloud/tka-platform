{
  "mcpServers": {
    "tka-domain": {
      "command": "cmd",
      "args": [
        "/c",
        "cd /d F:\\tka-platform\\mcp-server && npx -y tsx index.ts"
      ],
      "env": {}
    },
    "chrome-devtools": {
      "command": "npx.cmd",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--browserUrl=http://127.0.0.1:9222"
      ],
      "env": {}
    }
  }
}
