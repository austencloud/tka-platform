rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasValidUserId() {
      return isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
    }

    function isAdmin() {
      let userData = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isAuthenticated()
        && (userData.role == 'admin' || userData.isAdmin == true);
    }

    function isTester() {
      let userData = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isAuthenticated()
        && (userData.role == 'admin' || userData.role == 'tester' || userData.isAdmin == true);
    }

    function isPremium() {
      let userData = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isAuthenticated()
        && (userData.role == 'admin' || userData.role == 'tester' || userData.role == 'premium' || userData.isAdmin == true);
    }

    function isApprovedDeveloper() {
      return request.auth != null
        && exists(/databases/$(database)/documents/developers/$(request.auth.uid))
        && get(/databases/$(database)/documents/developers/$(request.auth.uid)).data.active == true;
    }

    function isDeveloperAdmin() {
      return isApprovedDeveloper()
        && get(/databases/$(database)/documents/developers/$(request.auth.uid)).data.role == "admin";
    }

    function isContributor() {
      return isApprovedDeveloper()
        && get(/databases/$(database)/documents/developers/$(request.auth.uid)).data.role == "contributor";
    }

    function isAgeVerified() {
      let userData = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isAuthenticated() && userData.ageVerifiedAt != null;
    }

    match /config/featureFlags {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /config/videoCategories {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /config/quickPerformers {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Effect point positions - readable by all (pre-auth safe)
    match /config/effectPoints {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Must allow unauthenticated reads: FireDefaultsLoader runs during DI
    // container construction before auth completes
    match /config/fireDefaults {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Prop geometry adjustments - arrow positioning offsets for pictograph rendering
    match /prop_geometry_adjustments/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /audit/featureFlags/entries/{entryId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false; // Immutable audit trail
    }

    match /userAchievements/{achievementId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if hasValidUserId();
      allow update: if isOwner(resource.data.userId);
      allow delete: if isOwner(resource.data.userId);
    }

    match /userXP/{xpId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if hasValidUserId();
      allow update: if isOwner(resource.data.userId);
      allow delete: if isOwner(resource.data.userId);
    }

    match /xpEvents/{eventId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if hasValidUserId();
      allow update, delete: if false; // Events are immutable
    }

    match /dailyChallenges/{challengeId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /weeklyChallenges/{challengeId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /skillProgressions/{skillId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /trainChallenges/{challengeId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /userChallengeProgress/{progressId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if hasValidUserId();
      allow update: if isOwner(resource.data.userId);
      allow delete: if isOwner(resource.data.userId);
    }

    match /userStreaks/{streakId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if hasValidUserId();
      allow update: if isOwner(resource.data.userId);
      allow delete: if isOwner(resource.data.userId);
    }

    match /achievementNotifications/{notificationId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if hasValidUserId();
      allow update: if isOwner(resource.data.userId);
      allow delete: if isOwner(resource.data.userId);
    }

    match /usernames/{usernameLowercase} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated()
        && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // INTENTIONAL PUBLIC READ ACCESS
    // The following collections use `allow read: if true` BY DESIGN.
    // This is NOT a security vulnerability - it's required for:
    //
    // 1. /users/{userId} - Public user profiles
    //    - Enables: Creator profiles, leaderboards, social features
    //    - Contains: Display name, avatar, public stats (XP, level, sequence count)
    //    - Sensitive data (email, settings) stored in protected subcollections
    //
    // 2. /users/{userId}/collections - Public collections
    //    - Enables: Sharing curated sequence collections
    //    - Privacy: isPublic flag controls visibility in UI
    //
    // 3. /users/{userId}/collections/{}/sequences - Sequences in collections
    //    - Enables: Viewing sequences in shared collections
    //    - Privacy: visibility field ("public"/"private") controls UI access
    //
    // 4. /sequences - Public sequences index
    //    - Enables: Browse page, search, gallery browsing
    //    - Only contains sequences users explicitly published
    //
    // 5. /collections - Public collections index
    //    - Enables: Browsing shared collections
    //
    // 6. /products - Subscription products catalog
    //    - Enables: Displaying pricing before auth
    //
    // SECURITY MODEL: Data separation, not access restriction
    // - Public data is stored in these public-readable collections
    // - Private data (messages, settings, drafts) uses auth-gated rules

    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId)
        || isAdmin()
        || (isAuthenticated()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followerCount'])
            && request.resource.data.followerCount == resource.data.followerCount + 1)
        || (isAuthenticated()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followerCount'])
            && request.resource.data.followerCount == resource.data.followerCount - 1);
      allow delete: if isOwner(userId) || isAdmin();

      match /settings/{settingId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /tags/{tagId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /achievements/{achievementId} {
        allow read: if true;
        allow create, update: if isOwner(userId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /xp/{xpId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /xpEvents/{eventId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if false; // Events are immutable
        allow delete: if isAdmin();
      }

      match /challengeProgress/{progressId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /streak/{streakId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /notifications/{notificationId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId) || isAdmin();
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /dismissedAnnouncements/{announcementId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /sessions/{sessionId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /onboarding/{docId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /drafts/{draftId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /following/{followedUserId} {
        allow read: if isAuthenticated();
        allow create, update: if isOwner(userId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /followers/{followerUserId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.auth.uid == followerUserId;
        allow update: if false;
        allow delete: if (isAuthenticated() && request.auth.uid == followerUserId) || isAdmin();
      }

      match /connections/{connectionId} {
        allow read, write: if isOwner(userId);
      }

      match /sequences/{sequenceId} {
        allow read: if resource.data.visibility == 'public' || isOwner(userId) || isAdmin();
        allow create: if isOwner(userId);
        allow update: if isOwner(userId) || isAdmin();
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /handPaths/{pathId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId);
        allow update: if isOwner(userId) || isAdmin();
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /soloProps/{soloPropId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId);
        allow update: if isOwner(userId) || isAdmin();
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /weeklyProgress/{progressId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /skillProgress/{progressId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /trainProgress/{progressId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /tikaConversations/{conversationId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /tikaInteractions/{topicId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /tikaVerifications/{verificationId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId);
        allow update: if false; // Immutable audit trail
        allow delete: if isAdmin();
      }

      match /learningProgress/{docId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /quizHistory/{attemptId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if false; // Quiz attempts are immutable
        allow delete: if isAdmin();
      }

      match /voiceSessions/{sessionId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /turnPatterns/{patternId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /rotationDirectionPatterns/{patternId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /fcmTokens/{tokenId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /users/{userId}/collections/{collectionId} {
      allow read: if true;
      allow create, update, delete: if isOwner(userId);
    }

    match /users/{userId}/collections/{collectionId}/sequences/{sequenceId} {
      allow read: if true;
      allow create, update, delete: if isOwner(userId);
    }

    match /sequences/{sequenceId} {
      allow read: if true;
      allow create: if isAuthenticated() && hasValidUserId();
      allow update, delete: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }

    match /collections/{collectionId} {
      allow read: if true;
      allow create: if isAuthenticated() && hasValidUserId();
      allow update, delete: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }

    function isConversationParticipant(conversationId) {
      let conv = get(/databases/$(database)/documents/conversations/$(conversationId)).data;
      return isAuthenticated() && (request.auth.uid in conv.participants || isAdmin());
    }

    match /conversations/{conversationId} {
      allow read: if isAuthenticated()
        && (request.auth.uid in resource.data.participants || isAdmin());

      allow create: if isAuthenticated()
        && (request.auth.uid in request.resource.data.participants || isAdmin())
        && (
          ((!('type' in request.resource.data) || request.resource.data.type == 'direct')
            && request.resource.data.participants.size() == 2)
          ||
          (request.resource.data.type == 'group'
            && request.resource.data.participants.size() >= 2
            && request.resource.data.participants.size() <= 50
            && request.auth.uid in request.resource.data.groupMetadata.adminIds
            && request.auth.uid == request.resource.data.groupMetadata.createdBy)
        );

      allow update: if isAuthenticated()
        && request.auth.uid in resource.data.participants
        && (
          ((!('type' in resource.data) || resource.data.type == 'direct')
            && request.resource.data.participants.size() == 2)
          ||
          (resource.data.type == 'group' && (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['unreadCount', 'lastMessage', 'updatedAt', 'typing'])
            ||
            request.auth.uid in resource.data.groupMetadata.adminIds
          ))
        );

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isConversationParticipant(conversationId);
        allow create: if isConversationParticipant(conversationId)
          && request.resource.data.senderId == request.auth.uid;
        allow update: if isConversationParticipant(conversationId)
          && (resource.data.senderId == request.auth.uid
              || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'readBy', 'readAt']));
        allow delete: if false;
      }
    }

    match /customers/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;

      match /checkout_sessions/{sessionId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid);
        allow update, delete: if false;
      }

      match /subscriptions/{subscriptionId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /payments/{paymentId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();

      match /prices/{priceId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /presence/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /users/{userId}/activityLog/{eventId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /contributors/{contributorId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /versions/{versionId} {
      allow read: if isTester();
      allow write: if isAdmin();
    }

    match /feedback/{feedbackId} {
      allow read: if isAuthenticated()
        && (resource.data.userId == request.auth.uid || isTester() || isApprovedDeveloper());
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isTester() || isApprovedDeveloper();
      allow delete: if isAdmin() || isDeveloperAdmin()
        || (isContributor() && resource.data.userId == request.auth.uid);

      match /subtasks/{subtaskId} {
        allow read: if isTester();
        allow write: if isTester();
      }

      match /journal/{entryId} {
        allow read: if isTester() || isApprovedDeveloper();
        allow create: if isTester() || isApprovedDeveloper();
        allow update, delete: if isAdmin();
      }
    }

    match /videos/{videoId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.creatorId == request.auth.uid;
      allow update: if isAuthenticated()
        && (resource.data.creatorId == request.auth.uid
            || request.auth.uid in resource.data.collaboratorIds);
      allow delete: if isAuthenticated()
        && resource.data.creatorId == request.auth.uid;
    }

    match /shortcodes/{code} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['scanCount']);
      allow delete: if isAdmin();

      match /scanEvents/{eventId} {
        allow read: if isAdmin();
        allow create: if true;
        allow update, delete: if false;
      }
    }

    match /publicSequences/{sequenceId} {
      allow read: if true;
      allow create, update: if isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid;
      allow delete: if isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid;
    }

    match /publicHandPaths/{pathId} {
      allow read: if true;
      allow create, update: if isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid;
      allow delete: if isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid;
    }

    match /publicSoloProps/{soloPropId} {
      allow read: if true;
      allow create, update: if isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid;
      allow delete: if isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid;
    }

    match /global_arrow_adjustments/{adjustmentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /global_arrow_adjustment_history/{entryId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /appMetrics/{metricId} {
      allow read: if true;
      allow write: if true;
    }

    match /liveBroadcast/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /userLocations/{userId} {
      allow read: if resource.data.visibility == 'public'
        || isOwner(userId)
        || isAdmin();
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /showcaseVideos/{videoId} {
      allow read: if isAuthenticated() || resource.data.approved == true;
      allow create, update, delete: if isAdmin();
    }

    match /userReports/{reportId} {
      allow read: if isAuthenticated()
        && (resource.data.reporterId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reportedUserId != request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /contentAppeals/{appealId} {
      allow read: if isAuthenticated()
        && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /hallOfShame/{sequenceId} {
      allow read: if isAdmin()
        || (isAuthenticated()
            && isAgeVerified()
            && (resource.data.status == 'approved' || resource.data.ownerId == request.auth.uid)
            && resource.data.hidden != true);

      allow create: if isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.voteCount == 0
        && request.resource.data.viewCount == 0
        && request.resource.data.reportCount == 0
        && request.resource.data.featured == false
        && request.resource.data.hidden == false;

      allow update: if isAdmin();

      allow delete: if isAuthenticated()
        && resource.data.ownerId == request.auth.uid
        && resource.data.status == 'pending';
    }

    match /hallOfShameVotes/{voteId} {
      allow read: if isAuthenticated() && isAgeVerified();
      allow create: if isAuthenticated()
        && isAgeVerified()
        && voteId == request.auth.uid + '_' + request.resource.data.sequenceId
        && request.resource.data.voterId == request.auth.uid;
      allow update, delete: if false;
    }

    match /hallOfShameRateLimits/{limitId} {
      allow read, create, update: if isAuthenticated()
        && limitId.matches(request.auth.uid + '_.*');
      allow delete: if isAdmin();
    }

    match /hallOfShameReports/{reportId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated()
        && isAgeVerified()
        && request.resource.data.reporterId == request.auth.uid;
      allow update, delete: if false;
    }

    match /loop-labels/{word} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /decks/{deckId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();

      match /sequences/{sequenceId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
      }
    }

    match /developers/{uid} {
      allow read: if isAuthenticated() && request.auth.uid == uid
                  || isApprovedDeveloper();
      allow write: if isDeveloperAdmin();
    }

    match /agentSessions/{sessionId} {
      allow read, write: if isApprovedDeveloper();
    }

    match /mail/{mailId} {
      allow create: if isApprovedDeveloper();
      allow read: if false;
    }

    match /festivals/{festivalId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();

      match /attendance/{uid} {
        allow read: if isAuthenticated();
        allow create, update: if isOwner(uid);
        allow delete: if isOwner(uid) || isAdmin();
      }
    }

    match /userFestivalTracking/{userId}/tracked/{festivalId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /userProfiles/{userId}/workshopPortfolio/{docId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /festivalSubmissions/{submissionId} {
      allow create: if isAuthenticated();
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Firestore denies by default
  }
}
