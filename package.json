{
  "name": "@tka/platform",
  "private": true,
  "type": "module",
  "description": "TKA Platform - monorepo for TKA Scribe and tkaflowarts.com",
  "scripts": {
    "dev:scribe": "pnpm --filter @tka/scribe dev",
    "build:scribe": "pnpm --filter @tka/scribe build",
    "check:scribe": "pnpm --filter @tka/scribe check",
    "dev:landing": "pnpm --filter @tka/landing dev",
    "build:landing": "pnpm --filter @tka/landing build",
    "build": "pnpm -r build",
    "check": "pnpm -r check"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  }
}
