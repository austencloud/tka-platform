{
  "name": "@tka/composer",
  "version": "0.22.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "description": "TKA Composer - Browser-based sequence editor for flow arts",
  "scripts": {
    "pictograph": "tsx scripts/pictograph-cli.ts",
    "dev": "vite --host 0.0.0.0",
    "dev:clean": "rimraf node_modules/.vite .svelte-kit && svelte-kit sync && npm run dev",
    "dev:debug": "NODE_OPTIONS='--inspect' vite --host 0.0.0.0",
    "dev:turbo": "vite --host 0.0.0.0 --force",
    "dev:kill": "npm run dev",
    "dev:mobile": "vite --host 0.0.0.0",
    "adb:connect": "node scripts/adb-connect.js",
    "adb:watch": "node scripts/adb-connect.js --watch",
    "build:native": "npm run build && npx cap sync",
    "cap:sync": "npx cap sync",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios",
    "capgo:upload": "npx @capgo/cli bundle upload",
    "build:packages": "tsc --project packages/tka-types/tsconfig.json && tsc --project packages/flow-arts-core/tsconfig.json && tsc --project packages/domain/tsconfig.json && tsc --project packages/vtg-domain/tsconfig.json && tsc --project packages/caps-domain/tsconfig.json && tsc --project packages/spin-science-domain/tsconfig.json && tsc --project packages/9square-domain/tsconfig.json && tsc --project packages/render-core/tsconfig.json && tsc --project packages/sequence-engine/tsconfig.json",
    "build": "npm run build:packages && svelte-kit sync && cross-env NODE_OPTIONS=--max-old-space-size=8192 vite build && node scripts/trim-deploy-assets.js",
    "build:fast": "npm run build:packages && svelte-kit sync && cross-env NODE_OPTIONS=--max-old-space-size=8192 NODE_ENV=production vite build",
    "build:all": "npm run build:packages && svelte-kit sync && cross-env NODE_OPTIONS=--max-old-space-size=8192 BUILD_ALL=true vite build",
    "build:analyze": "vite-bundle-visualizer",
    "size": "size-limit",
    "size:why": "size-limit --why",
    "bundle:metadata": "node scripts/bundle-sequence-metadata.mjs",
    "build:primitive-catalog": "node scripts/build-primitive-catalog.cjs",
    "preview": "vite preview",
    "i18n:types": "node scripts/generate-i18n-types.cjs",
    "i18n:validate": "node scripts/validate-i18n.cjs",
    "i18n:validate:fix": "node scripts/validate-i18n.cjs --fix",
    "i18n:coverage": "node scripts/validate-i18n.cjs --coverage",
    "css:rtl": "node scripts/audit-css-rtl.cjs",
    "css:rtl:summary": "node scripts/audit-css-rtl.cjs --summary",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --compiler-warnings \"state_referenced_locally:ignore\"",
    "check:fast": "svelte-kit sync && svelte-fast-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --compiler-warnings \"state_referenced_locally:ignore\" --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest --config tests/config/vitest.config.ts",
    "test:ui": "vitest --config tests/config/vitest.config.ts --ui",
    "lint": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "format": "prettier --write .",
    "test:ci": "vitest run --config tests/config/vitest.config.ts",
    "validate": "npm run lint && npm run check && npm run test:ci",
    "validate:all": "node tools/validate-all.js",
    "validate:architecture": "node tools/validate-architecture.js",
    "validate:seo": "node tools/validate-seo.js",
    "test:seo-live": "node tools/test-seo-live.js",
    "optimize:images": "node tools/convert-to-webp.js",
    "optimize:ios": "node tools/generate-ios-assets.js",
    "validate:metadata": "node tools/validate-metadata-accuracy.js",
    "migrate:metadata": "node tools/migrate-png-metadata-to-webp.js",
    "clean": "rimraf build .svelte-kit node_modules/.vite",
    "clean:all": "rimraf build .svelte-kit node_modules",
    "analyze:dead-code": "ts-prune --project tsconfig.json > ts-prune-full-report.txt && node analyze-dead-code.js && node verify-usage.js",
    "analyze:dead-code:quick": "ts-prune --project tsconfig.json | grep -v '(used in module)' | grep 'src\\\\lib\\\\modules' | wc -l",
    "postinstall": "svelte-kit sync",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "release:setup": "node scripts/setup-release-workflow.js",
    "feedback:flow": "node scripts/feedback-workflow.js",
    "env:check": "node scripts/check-environment.js",
    "env:dev": "node scripts/switch-environment.js dev",
    "env:prod": "node scripts/switch-environment.js prod",
    "monolith": "node scripts/find-monoliths.cjs",
    "monolith:all": "node scripts/find-monoliths.cjs --all",
    "models:download": "node scripts/model-curator/download-packs.cjs",
    "models:scan": "node scripts/model-curator/scan-models.cjs",
    "models:curate": "node scripts/model-curator/curator-server.cjs",
    "sort-arrows": "node scripts/sort-arrows.js",
    "sort-arrows:dry": "node scripts/sort-arrows.js --dry-run",
    "arrows:watch": "node scripts/sort-arrows.js --watch",
    "arrows:sync": "node scripts/arrows-sync.js",
    "arrows:export": "node scripts/arrows-sync.js --once",
    "arrows:template": "node scripts/generate-arrow-template.js",
    "arrows:create": "node scripts/create-arrow-document.js",
    "tika:evaluate": "npx tsx scripts/tika/evaluate.ts",
    "tika:evaluate:dry": "npx tsx scripts/tika/evaluate.ts --dry-run",
    "tika:opus": "npx tsx scripts/tika/opus-reviewer.ts",
    "tika:opus:demo": "npx tsx scripts/tika/opus-reviewer.ts --demo",
    "screenshots": "tsx scripts/take-screenshots.ts",
    "screenshots:public": "tsx scripts/take-screenshots.ts --public",
    "screenshots:compare": "tsx scripts/take-screenshots.ts --compare",
    "screenshots:update": "tsx scripts/take-screenshots.ts --update-baselines",
    "collision-lab:scan": "tsx scripts/scan-collision-lab.ts",
    "collision-lab:scan:verbose": "tsx scripts/scan-collision-lab.ts --verbose",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:icons": "tauri icon static/pwa/icons/icon-512x512.png",
    "export:deck-bundle": "node scripts/export-deck-bundle.cjs"
  },
  "overrides": {
    "cookie": "^0.7.2",
    "threlte-postprocessing": {
      "three": "$three"
    }
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.0",
    "@chromatic-com/storybook": "^4.1.3",
    "@eslint/js": "^9.39.2",
    "@size-limit/file": "^12.0.0",
    "@size-limit/preset-app": "^12.0.0",
    "@storybook/addon-a11y": "^10.0.8",
    "@storybook/addon-docs": "^10.0.8",
    "@storybook/addon-svelte-csf": "^5.0.10",
    "@storybook/addon-vitest": "^10.0.8",
    "@storybook/sveltekit": "^10.0.8",
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@sveltejs/kit": "^2.48.5",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tauri-apps/cli": "^2.10.1",
