    "@types/node": "^25.0.3",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.182.0",
    "@types/web-bluetooth": "^0.0.21",
    "@vitest/browser": "^4.0.16",
    "canvas": "^3.2.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-check-file": "^3.3.1",
    "eslint-plugin-svelte": "^3.13.1",
    "globals": "^17.6.0",
    "jsdom": "^27.4.0",
    "knip": "^5.82.1",
    "lightningcss": "^1.30.2",
    "pixelmatch": "^6.0.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.1",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "rimraf": "^6.1.2",
    "rollup-plugin-visualizer": "^6.0.5",
    "sharp": "^0.34.5",
    "storybook": "^10.0.8",
    "stripe": "^20.1.0",
    "svelte": "^5.46.1",
    "svelte-check": "^4.3.5",
    "svelte-confetti": "^2.3.2",
    "svelte-fast-check": "0.4.5",
    "svg-path-commander": "^2.1.11",
    "ts-morph": "^28.0.0",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vite-plugin-static-copy": "^3.1.4",
    "vitest": "^4.0.16",
    "web-vitals": "^5.1.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "prettier": {
    "semi": true,
    "trailingComma": "es5",
    "singleQuote": false,
    "printWidth": 80,
    "tabWidth": 2,
    "useTabs": false,
    "plugins": [
      "prettier-plugin-svelte",
      "prettier-plugin-tailwindcss"
    ],
    "overrides": [
      {
        "files": "*.svelte",
        "options": {
          "parser": "svelte"
        }
      }
    ]
  },
  "size-limit": [
    {
      "name": "Main bundle (JS)",
      "path": ".svelte-kit/output/client/_app/immutable/chunks/C_cjnAVj.js",
      "limit": "350 KB",
      "gzip": true
    },
    {
      "name": "Vendor chunk (dependencies)",
      "path": ".svelte-kit/output/client/_app/immutable/chunks/CqlUKxnS.js",
      "limit": "270 KB",
      "gzip": true
    },
    {
      "name": "Core domain logic",
      "path": ".svelte-kit/output/client/_app/immutable/chunks/Df4sM1ji.js",
      "limit": "150 KB",
      "gzip": true
    },
    {
      "name": "Total CSS",
      "path": ".svelte-kit/output/client/_app/immutable/assets/index.BrW9jqdU.css",
      "limit": "90 KB",
      "gzip": true
    }
  ],
