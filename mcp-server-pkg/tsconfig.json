{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "declaration": true,
    "declarationDir": "./dist",
    "noEmit": false,
    "rootDir": ".",
    "paths": {
      "@tka/render-core": ["../packages/render-core/dist/index.d.ts"]
    }
  },
  "include": ["index.ts", "src/**/*.ts", "vendor/sequence-engine/**/*.ts"],
  "exclude": ["node_modules"]
}
