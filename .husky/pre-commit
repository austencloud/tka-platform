#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Auto-detect branch and set environment
BRANCH=$(git rev-parse --abbrev-ref HEAD)

if [ "$BRANCH" = "main" ] || [ "$BRANCH" = "release" ]; then
  # Check if contributor (non-admin) is committing to main
  CREDS_FILE="$HOME/.tka/credentials.json"
  ADMIN_UID="PBp3GSBO6igCKPwJyLZNmVEmamI3"

  if [ -f "$CREDS_FILE" ]; then
    USER_UID=$(node -e "try{console.log(JSON.parse(require('fs').readFileSync('$CREDS_FILE','utf8')).uid)}catch{}" 2>/dev/null)

    if [ -n "$USER_UID" ] && [ "$USER_UID" != "$ADMIN_UID" ]; then
      echo ""
      echo "  ❌ Contributors cannot commit directly to main."
      echo ""
      echo "  Create a feature branch first:"
      echo "    git checkout -b fb/<feedback-id>-short-description"
      echo ""
      exit 1
    fi
  fi

  echo "⚠️  Committing to production branch ($BRANCH)"
fi

# Run type checking on staged files
echo "🔍 Running type check..."
npx svelte-check --tsconfig ./tsconfig.json --compiler-warnings "state_referenced_locally:ignore" 2>/dev/null
if [ $? -ne 0 ]; then
  echo ""
  echo "  ❌ Type check failed. Fix errors before committing."
  echo "  Run: npm run check"
  echo ""
  exit 1
fi
echo "✅ Type check passed"

# Verify module/tab definitions have matching i18n keys
echo "🔍 Checking i18n structural coverage..."
node scripts/validate-i18n-structure.cjs --ci 2>/dev/null
if [ $? -ne 0 ]; then
  echo ""
  echo "  ❌ Missing i18n keys for module/tab definitions."
  echo "  Run: npm run i18n:structure:fix"
  echo ""
  exit 1
fi
echo "✅ i18n structure check passed"
