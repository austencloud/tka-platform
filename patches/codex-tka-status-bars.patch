+++ b/codex-rs/tui/src/app/thread_name_generation_tests.rs
@@ -0,0 +1,103 @@
+use super::PendingThreadNameGeneration;
+use super::normalize_generated_thread_name;
+use super::parse_generated_thread_name;
+use codex_app_server_protocol::ItemCompletedNotification;
+use codex_app_server_protocol::ServerNotification;
+use codex_app_server_protocol::ThreadDeletedNotification;
+use codex_app_server_protocol::ThreadItem;
+use codex_app_server_protocol::Turn;
+use codex_app_server_protocol::TurnCompletedNotification;
+use codex_app_server_protocol::TurnItemsView;
+use codex_app_server_protocol::TurnStatus;
+use codex_protocol::ThreadId;
+use pretty_assertions::assert_eq;
+
+#[test]
+fn generated_thread_name_accepts_two_to_four_words() {
+    assert_eq!(
+        normalize_generated_thread_name("Terminal Naming").as_deref(),
+        Ok("Terminal Naming")
+    );
+    assert_eq!(
+        normalize_generated_thread_name("Codex Session Rename Flow").as_deref(),
+        Ok("Codex Session Rename Flow")
+    );
+}
+
+#[test]
+fn generated_thread_name_normalizes_common_model_separators() {
+    assert_eq!(
+        normalize_generated_thread_name("terminal-name-sync").as_deref(),
+        Ok("terminal name sync")
+    );
+    assert_eq!(
+        parse_generated_thread_name(r#"{"name":"Claude Rename"}"#).as_deref(),
+        Ok("Claude Rename")
+    );
+}
+
+#[test]
+fn generated_thread_name_rejects_the_wrong_word_count() {
+    assert!(normalize_generated_thread_name("Rename").is_err());
+    assert!(normalize_generated_thread_name("One Two Three Four Five").is_err());
+    assert!(normalize_generated_thread_name("   ").is_err());
+}
+
+#[tokio::test]
+async fn naming_thread_notifications_stay_hidden_and_capture_the_final_name() {
+    let mut app = crate::app::test_support::make_test_app().await;
+    let parent_thread_id = ThreadId::new();
+    let generator_thread_id = ThreadId::new();
+    app.pending_thread_name_generations.insert(
+        generator_thread_id,
+        PendingThreadNameGeneration::new(parent_thread_id),
+    );
+
+    let item_completed = ServerNotification::ItemCompleted(ItemCompletedNotification {
+        thread_id: generator_thread_id.to_string(),
+        turn_id: "rename-turn".to_string(),
+        completed_at_ms: 1,
+        item: ThreadItem::AgentMessage {
+            id: "rename-message".to_string(),
+            text: r#"{"name":"Terminal Naming"}"#.to_string(),
+            phase: None,
+            memory_citation: None,
+        },
+    });
+    assert!(app.handle_thread_name_generation_notification(generator_thread_id, &item_completed));
+    assert_eq!(
+        app.pending_thread_name_generations
+            .get(&generator_thread_id)
+            .and_then(|pending| pending.response.as_deref()),
+        Some(r#"{"name":"Terminal Naming"}"#)
+    );
+
+    let turn_completed = ServerNotification::TurnCompleted(TurnCompletedNotification {
+        thread_id: generator_thread_id.to_string(),
+        turn: Turn {
+            id: "rename-turn".to_string(),
+            items: Vec::new(),
+            items_view: TurnItemsView::Full,
+            status: TurnStatus::Completed,
+            error: None,
+            started_at: Some(0),
+            completed_at: Some(1),
+            duration_ms: Some(1),
+        },
+    });
+    assert!(app.handle_thread_name_generation_notification(generator_thread_id, &turn_completed));
+    assert!(app.pending_thread_name_generations[&generator_thread_id].completion_queued);
+
+    app.pending_thread_name_generations
+        .remove(&generator_thread_id);
+    app.ignored_thread_name_generation_threads
+        .insert(generator_thread_id);
+    let deleted = ServerNotification::ThreadDeleted(ThreadDeletedNotification {
+        thread_id: generator_thread_id.to_string(),
+    });
+    assert!(app.handle_thread_name_generation_notification(generator_thread_id, &deleted));
+    assert!(
+        !app.ignored_thread_name_generation_threads
+            .contains(&generator_thread_id)
+    );
+}
