diff --git a/codex-rs/tui/src/app/thread_name_generation.rs b/codex-rs/tui/src/app/thread_name_generation.rs
new file mode 100644
index 0000000000..471d70b61b
--- /dev/null
+++ b/codex-rs/tui/src/app/thread_name_generation.rs
@@ -0,0 +1,275 @@
+//! Invisible, model-generated names for bare `/rename` commands.
+
+use super::App;
+use super::AppRunControl;
+use crate::app_command::AppCommand;
+use crate::app_event::AppEvent;
+use crate::app_server_session::AppServerSession;
+use crate::legacy_core::config::Config;
+use codex_app_server_protocol::AskForApproval;
+use codex_app_server_protocol::ServerNotification;
+use codex_app_server_protocol::ThreadItem;
+use codex_app_server_protocol::TurnStatus;
+use codex_app_server_protocol::UserInput;
+use codex_protocol::ThreadId;
+use color_eyre::eyre::Result;
+use serde_json::Value;
+use serde_json::json;
+
+const THREAD_NAME_DEVELOPER_INSTRUCTIONS: &str = "You name an existing coding conversation. Do not call tools, change files, or continue the work. Return only the required JSON object.";
+const THREAD_NAME_PROMPT: &str = "Choose an accurate two- to four-word Title Case name for the main topic of this conversation. If several topics compete, choose the title that best represents the chat as a whole. Never name a transient action such as running tests, reading files, or checking status.";
+
+#[derive(Debug)]
+pub(super) struct PendingThreadNameGeneration {
+    parent_thread_id: ThreadId,
+    response: Option<String>,
+    completion_queued: bool,
+}
+
+impl PendingThreadNameGeneration {
+    fn new(parent_thread_id: ThreadId) -> Self {
+        Self {
+            parent_thread_id,
+            response: None,
+            completion_queued: false,
+        }
+    }
+}
+
+impl App {
+    fn thread_name_fork_config(&self) -> Config {
+        let mut config = self.chat_widget.config_ref().clone();
+        let parent_model = self.chat_widget.current_model();
+        if !parent_model.trim().is_empty() {
+            config.model = Some(parent_model.to_string());
+        }
+        config.model_reasoning_effort = self.chat_widget.current_reasoning_effort();
+        config.service_tier = self.chat_widget.configured_service_tier();
+        config.ephemeral = true;
+        config.developer_instructions = Some(THREAD_NAME_DEVELOPER_INSTRUCTIONS.to_string());
+        config
+    }
+
+    fn thread_name_turn(&self) -> AppCommand {
+        let config = self.chat_widget.config_ref();
+        AppCommand::user_turn(
+            vec![UserInput::Text {
+                text: THREAD_NAME_PROMPT.to_string(),
+                text_elements: Vec::new(),
+            }],
+            config.cwd.to_path_buf(),
+            AskForApproval::from(config.permissions.approval_policy.value()),
+            config.permissions.active_permission_profile(),
+            self.chat_widget.current_model().to_string(),
+            self.chat_widget.current_reasoning_effort(),
+            /*summary*/ None,
+            self.chat_widget.service_tier_update_for_core(),
+            Some(thread_name_output_schema()),
+            /*collaboration_mode*/ None,
+            /*personality*/ None,
+        )
+    }
+
+    pub(super) async fn handle_generate_thread_name(
+        &mut self,
+        app_server: &mut AppServerSession,
+        parent_thread_id: ThreadId,
+    ) -> Result<AppRunControl> {
+        if self
+            .pending_thread_name_generations
+            .values()
+            .any(|pending| pending.parent_thread_id == parent_thread_id)
+        {
+            self.chat_widget
+                .add_error_message("A session name is already being chosen.".to_string());
+            return Ok(AppRunControl::Continue);
+        }
+
+        let fork_config = self.thread_name_fork_config();
+        let turn = self.thread_name_turn();
+        let forked = match app_server.fork_thread(fork_config, parent_thread_id).await {
+            Ok(forked) => forked,
+            Err(err) => {
+                let detail = if err.chain().any(|cause| {
+                    let message = cause.to_string();
+                    message.contains("no rollout found for thread id")
+                        || message.contains("includeTurns is unavailable before first user message")
+                }) {
+                    "there is no conversation context yet".to_string()
+                } else {
+                    err.to_string()
+                };
+                self.fail_thread_name_generation(detail);
+                return Ok(AppRunControl::Continue);
+            }
+        };
+
+        let generator_thread_id = forked.session.thread_id;
+        self.pending_thread_name_generations.insert(
+            generator_thread_id,
+            PendingThreadNameGeneration::new(parent_thread_id),
+        );
+
+        if let Err(err) = self
+            .submit_thread_op(app_server, generator_thread_id, turn)
+            .await
+        {
+            self.pending_thread_name_generations
+                .remove(&generator_thread_id);
+            self.ignored_thread_name_generation_threads
+                .insert(generator_thread_id);
+            if let Err(delete_err) = app_server.thread_delete(generator_thread_id).await {
+                tracing::warn!(
+                    thread_id = %generator_thread_id,
+                    "failed to delete name-generator thread after start failure: {delete_err}"
+                );
+            }
+            self.fail_thread_name_generation(err.to_string());
+        }
+
+        Ok(AppRunControl::Continue)
+    }
+
+    pub(super) fn handle_thread_name_generation_notification(
+        &mut self,
+        thread_id: ThreadId,
+        notification: &ServerNotification,
+    ) -> bool {
+        if self
+            .ignored_thread_name_generation_threads
+            .contains(&thread_id)
+        {
+            if matches!(notification, ServerNotification::ThreadDeleted(_)) {
+                self.ignored_thread_name_generation_threads
+                    .remove(&thread_id);
+            }
+            return true;
+        }
+
+        let Some(pending) = self.pending_thread_name_generations.get_mut(&thread_id) else {
+            return false;
+        };
+
+        match notification {
+            ServerNotification::ItemCompleted(notification) => {
+                if let ThreadItem::AgentMessage { text, .. } = &notification.item {
+                    pending.response = Some(text.clone());
+                }
+            }
+            ServerNotification::TurnCompleted(notification) if !pending.completion_queued => {
+                pending.completion_queued = true;
+                self.app_event_tx
+                    .send(AppEvent::FinishThreadNameGeneration {
+                        generator_thread_id: thread_id,
+                        succeeded: notification.turn.status == TurnStatus::Completed,
+                    });
+            }
+            _ => {}
+        }
+        true
+    }
+
+    pub(super) async fn finish_thread_name_generation(
+        &mut self,
+        app_server: &mut AppServerSession,
+        generator_thread_id: ThreadId,
+        succeeded: bool,
+    ) {
+        let Some(pending) = self
+            .pending_thread_name_generations
+            .remove(&generator_thread_id)
+        else {
+            return;
+        };
+        self.ignored_thread_name_generation_threads
+            .insert(generator_thread_id);
+
+        let generated_name = if succeeded {
+            pending
+                .response
+                .as_deref()
+                .ok_or_else(|| "the naming turn returned no response".to_string())
+                .and_then(parse_generated_thread_name)
+        } else {
+            Err("the naming turn failed".to_string())
+        };
+
+        let rename_result = match generated_name {
+            Ok(name) => {
+                self.chat_widget
+                    .set_queue_autosend_suppressed(/*suppressed*/ false);
+                app_server
+                    .thread_set_name(pending.parent_thread_id, name)
+                    .await
+                    .map_err(|err| err.to_string())
+            }
+            Err(err) => Err(err),
+        };
+
+        if let Err(err) = app_server.thread_delete(generator_thread_id).await {
+            tracing::warn!(
+                thread_id = %generator_thread_id,
+                "failed to delete completed name-generator thread: {err}"
+            );
+        }
+
+        if let Err(err) = rename_result {
+            self.fail_thread_name_generation(err);
+        }
+    }
+
+    fn fail_thread_name_generation(&mut self, detail: String) {
+        self.chat_widget
+            .set_queue_autosend_suppressed(/*suppressed*/ false);
+        self.chat_widget
+            .add_error_message(format!("Could not choose a session name: {detail}."));
+        self.chat_widget.maybe_send_next_queued_input();
+    }
+}
+
+fn thread_name_output_schema() -> Value {
+    json!({
+        "type": "object",
+        "additionalProperties": false,
+        "properties": {
+            "name": {
+                "type": "string",
+                "description": "An accurate two- to four-word Title Case conversation name"
+            }
+        },
+        "required": ["name"]
+    })
+}
+
+fn parse_generated_thread_name(response: &str) -> std::result::Result<String, String> {
+    let value: Value = serde_json::from_str(response.trim())
+        .map_err(|_| "the naming turn returned invalid JSON".to_string())?;
+    let raw_name = value
+        .get("name")
+        .and_then(Value::as_str)
+        .ok_or_else(|| "the naming turn returned no name".to_string())?;
+    normalize_generated_thread_name(raw_name)
+}
+
+fn normalize_generated_thread_name(raw_name: &str) -> std::result::Result<String, String> {
+    let normalized_separators = raw_name.replace(['-', '_'], " ");
+    let words = normalized_separators
+        .split_whitespace()
+        .map(|word| {
+            word.trim_matches(|character: char| {
+                matches!(character, '`' | '"' | '\'' | '.' | ',' | ':' | ';')
+            })
+        })
+        .filter(|word| !word.is_empty())
+        .collect::<Vec<_>>();
+
+    if !(2..=4).contains(&words.len()) {
+        return Err("the generated name was not two to four words".to_string());
+    }
+
+    Ok(words.join(" "))
+}
+
+#[cfg(test)]
+#[path = "thread_name_generation_tests.rs"]
+mod tests;
