+fn usage_meter(item: StatusLineItem, text: &str) -> Option<(&'static str, u8)> {
+    let displayed_percent = percent_from_text(text)?;
+    let (label, used_percent) = match item {
+        StatusLineItem::ContextUsed => ("ctx", displayed_percent),
+        StatusLineItem::ContextRemaining => ("ctx", 100_u8.saturating_sub(displayed_percent)),
+        StatusLineItem::FiveHourLimit => ("5h", 100_u8.saturating_sub(displayed_percent)),
+        StatusLineItem::WeeklyLimit => ("7d", 100_u8.saturating_sub(displayed_percent)),
+        _ => return None,
+    };
+    Some((label, used_percent.min(100)))
+}
+
+fn percent_from_text(text: &str) -> Option<u8> {
+    let percent_sign = text.find('%')?;
+    let digits = text[..percent_sign]
+        .chars()
+        .rev()
+        .take_while(|character| character.is_ascii_digit())
+        .collect::<String>()
+        .chars()
+        .rev()
+        .collect::<String>();
+    digits.parse().ok()
+}
+
+fn append_usage_meter(spans: &mut Vec<Span<'static>>, label: &'static str, percent: u8) {
+    let filled = ((usize::from(percent) * USAGE_METER_CELLS + 50) / 100).min(USAGE_METER_CELLS);
+    let color = match percent {
+        USAGE_DANGER_PERCENT..=u8::MAX => Color::Red,
+        USAGE_WARNING_PERCENT..USAGE_DANGER_PERCENT => Color::Rgb(255, 165, 0),
+        _ => Color::Green,
+    };
+    let active = Style::default().fg(color);
+    let track = Style::default().fg(Color::DarkGray);
+
+    spans.push(Span::styled(format!("{label} ["), active));
+    if filled > 0 {
+        spans.push(Span::styled("█".repeat(filled), active));
+    }
+    if filled < USAGE_METER_CELLS {
+        spans.push(Span::styled("░".repeat(USAGE_METER_CELLS - filled), track));
+    }
+    spans.push(Span::styled(format!("] {percent}%"), active));
+}
+
