+import { type AnimationClip, type Object3D } from "three";
+/** Where one foot goes, and when it is on the floor. */
+export interface FootTrack {
+    /**
+     * Ankle per sample, offset from this leg's own hip joint.
+     *
+     * Measured from the hip joint rather than from the pelvis so that no rig can
+     * be asked for more reach than it has. The offset is at most one source leg
+     * long by definition, so scaling it is at most one target leg long, and the
+     * goal is inside the leg before the solver ever sees it.
+     */
+    ankle: Float32Array;
+    /** Ball of the foot, same three numbers from the same joint. */
+    toe: Float32Array;
+    /** This hip joint's height above the floor, in leg lengths. */
+    hip: Float32Array;
+    /** 1 while the foot is on the floor. */
+    contact: Uint8Array;
+}
+/**
+ * What a source clip does with its feet, in units no rig owns.
+ *
+ * Every distance here is divided by the source's own leg length, so the same
+ * footprint drives a rig a head taller without carrying a centimetre of the
+ * body it was measured on. Horizontal is measured from the hips, which makes
+ * an in-place cycle out of a clip that travels and leaves an in-place clip
+ * alone; vertical is measured from the floor, the only anchor that survives
+ * two rigs standing at different heights.
+ */
+export interface ClipFootprint {
+    samples: number;
+    duration: number;
+    /**
+     * Pelvis height per sample, above the floor and in leg lengths.
+     *
+     * A walk carries its pelvis several centimetres below where the same body
+     * stands, because both knees are bent through the whole cycle, and it dips
+     * again over each mid-stance. Anchor the pelvis at standing height instead
+     * and the legs are asked to reach further than they are long: the foot that
+     * should be on the floor hangs a few centimetres above it for the whole
+     * stance. Carrying the height here, in the same units as the feet, keeps
+     * every goal inside the leg by construction.
+     */
+    hips: Float32Array;
+    left: FootTrack;
+    right: FootTrack;
+}
+export declare function registerClipFootprint(clip: AnimationClip, footprint: ClipFootprint): void;
+export declare function getClipFootprint(clip: AnimationClip): ClipFootprint | null;
+/**
+ * Read a clip's foot contacts off the rig it was authored on.
+ *
+ * This has to happen while that rig is still in memory. Animation GLBs ship a
+ * whole character next to the clip and the loader drops it immediately, which
+ * is worth hundreds of megabytes across a cast - so the few kilobytes that say
+ * where the feet went are taken first, and the character still goes.
+ *
+ * The clip is played on `scene`, which is left posed at its last sample.
+ */
+export declare function extractClipFootprint(scene: Object3D, clip: AnimationClip): ClipFootprint | null;
