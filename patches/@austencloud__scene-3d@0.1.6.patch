+/**
+ * Prop Finish State
+ *
+ * Some props exist in two real builds: the fire one you burn and the day one
+ * you practise with.
+ */
+import { PropType } from "../domain/enums/PropType";
+export type PropFinish = "fire" | "day";
+declare class PropFinishState {
+    private _finish;
+    get finish(): PropFinish;
+    set(finish: PropFinish): void;
+    toggle(): void;
+}
+export declare const propFinishState: PropFinishState;
+export declare function propHasFinishVariants(propType: PropType): boolean;
+export {};
