+ *
+ * Performer rigs frequently use the same avatar and locomotion files. Browser
+ * caching avoids another download, but GLTFLoader would still parse the same
+ * binary again for every performer. Keeping the parsed result here removes
+ * that repeated main-thread work. A failed request is evicted so retry still
+ * works after a temporary network problem.
+ */
+export function loadSharedGltf(url: string): Promise<GLTF> {
+  const existing = loads.get(url);
+  if (existing) return existing;
+
+  const pending = loader.loadAsync(url);
+  loads.set(url, pending);
+  void pending.catch(() => {
+    if (loads.get(url) === pending) loads.delete(url);
+  });
+  return pending;
+}
+
+/**
+ * Parse an avatar before another performer needs it.
+ *
+ * The first visible performer starts this work. Later performers then clone
+ * the prepared scene instead of briefly showing a stand-in while the same
+ * model is parsed again.
+ */
+export function prepareSharedGltf(url: string): Promise<void> {
+  return loadSharedGltf(url).then(() => undefined);
+}
+
+/**
+ * Parse an animation GLB once without retaining the file's embedded scene.
+ *
+ * Mixamo animation exports often include a complete character alongside the
+ * clip. Keeping the entire GLTF for every locomotion asset costs hundreds of
+ * megabytes. This cache retains only the immutable AnimationClip shared by
+ * every performer and lets the unused scene graph be collected.
+ */
+export function loadSharedAnimation(url: string): Promise<AnimationClip> {
+  const existing = animationLoads.get(url);
+  if (existing) return existing;
+
+  const pending = loader.loadAsync(url).then((gltf) => {
+    const clip = gltf.animations[0];
+    if (!clip) throw new Error(`No animation in ${url}`);
+    return clip;
+  });
+  animationLoads.set(url, pending);
+  void pending.catch(() => {
+    if (animationLoads.get(url) === pending) animationLoads.delete(url);
+  });
+  return pending;
+}
+
+/** Share existence probes used before optional animation packs are loaded. */
+export function checkSharedAssetAvailability(url: string): Promise<boolean> {
+  const existing = availabilityChecks.get(url);
+  if (existing) return existing;
+
+  const pending = fetch(url, { method: "HEAD" }).then((response) => {
+    const contentType = response.headers.get("content-type") ?? "";
+    return response.ok && !contentType.includes("text/html");
+  });
+  availabilityChecks.set(url, pending);
+  void pending.catch(() => {
+    if (availabilityChecks.get(url) === pending) availabilityChecks.delete(url);
+  });
+  return pending;
+}
+
+/**
+ * Spread independent performer setup across frames in mount order.
+ *
+ * Svelte mounts every new rig synchronously. Serializing the heavy clone and
+ * mixer setup keeps a batch add from becoming one long main-thread task while
+ * the light state change and formation motion remain immediate.
+ */
+let performerInitializationQueue: Promise<void> = Promise.resolve();
+
+export async function schedulePerformerInitialization<T>(
+  initialize: () => Promise<T>
+): Promise<T> {
+  const predecessor = performerInitializationQueue;
+  let release!: () => void;
+  performerInitializationQueue = new Promise<void>((resolve) => {
+    release = resolve;
+  });
+
+  try {
+    await predecessor;
+    await yieldUntilAfterPaint();
+    return await initialize();
+  } finally {
+    release();
+  }
+}
+
+/**
+ * Mount one expensive performer subtree after the browser has painted.
+ *
+ * The callback is intentionally synchronous: it only opens a Svelte render
+ * gate. Avatar parsing has its own async initialization queue above. Keeping
+ * these queues separate prevents a network request from delaying the next
+ * performer's lightweight shell while still limiting WebGL setup to one
+ * subtree per painted frame.
+ */
+let performerMountQueue: Promise<void> = Promise.resolve();
+
+export async function schedulePerformerMount(mount: () => void): Promise<void> {
+  const predecessor = performerMountQueue;
+  let release!: () => void;
+  performerMountQueue = new Promise<void>((resolve) => {
+    release = resolve;
+  });
+
+  try {
+    await predecessor;
+    await yieldUntilAfterPaint();
+    mount();
+  } finally {
+    release();
+  }
+}
+
+/**
+ * Give one performer an independently animatable skeleton while sharing the
+ * immutable geometry and textures from the parsed model. Materials are cloned
+ * because performer fades and customization mutate opacity and color.
+ */
+export function cloneSharedSkinnedScene(source: Object3D): Object3D {
+  const scene = cloneSkinned(source);
+  scene.traverse((child) => {
+    const mesh = child as Mesh;
+    if (!mesh.isMesh || !mesh.material) return;
+
+    mesh.material = Array.isArray(mesh.material)
+      ? mesh.material.map((material) => material.clone())
+      : (mesh.material as Material).clone();
+  });
+  return scene;
+}
+
+/** Test-only reset for proving retry and deduplication behavior. */
+export function clearSharedGltfCache(): void {
+  loads.clear();
+  animationLoads.clear();
+  availabilityChecks.clear();
+  performerInitializationQueue = Promise.resolve();
+  performerMountQueue = Promise.resolve();
+}
