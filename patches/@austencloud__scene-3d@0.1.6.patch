+    // Same point, same distance from the ankle, at the height of the floor.
+    const wantY = Math.min(reach, rig.floor - ankleLocal.y);
+    const flat = Math.hypot(armWas.x, armWas.z);
+    const wantFlat = Math.sqrt(Math.max(0, reach * reach - wantY * wantY));
