+  const frame = hips.parent ?? root;
+  return {
+    hips,
+    hipsRest: hips.position.clone(),
+    frame,
+    legLength: legLengthIn(frame, left.chain),
+    floor: restFloor(frame, left.toe, right.toe),
+    left,
+    right,
+  };
