+        trace(new Path(), HOLE_FORWARD_LEFT, staffLength),
+        trace(new Path(), HOLE_PIVOT, staffLength),
+        trace(new Path(), HOLE_FORWARD_RIGHT, staffLength),
+        trace(new Path(), HOLE_FLANK_RIGHT, staffLength),
+    ];
