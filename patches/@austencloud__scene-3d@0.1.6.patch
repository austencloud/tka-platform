+    [0.01483, -0.51384, -0.00494, -0.51384, -0.01206, -0.51384],
+    [-0.02393, -0.51384, -0.03975, -0.51187, -0.06112, -0.50791],
+    [-0.13232, -0.48695, -0.19086, -0.44146, -0.22369, -0.38252],
+    [-0.26642, -0.31606, -0.27512, -0.23101, -0.24703, -0.14992],
