@@ -0,0 +1,390 @@
+import { Box3 } from "three";
+import { extractClipFootprint, registerClipFootprint, } from "./clip-footprint";
+import { GLTFLoader, } from "three/examples/jsm/loaders/GLTFLoader.js";
+import { clone as cloneSkinned } from "three/examples/jsm/utils/SkeletonUtils.js";
+import { avatarAssetLabel, recordAvatarLoadSpan, } from "../debug/avatar-load-instrumentation";
+const loader = new GLTFLoader();
+const loads = new Map();
+const animationLoads = new Map();
+const availabilityChecks = new Map();
+const avatarBounds = new Map();
+const MAX_AVATAR_TEXTURE_DIMENSION = 1024;
+const avatarRenderContexts = new Map();
+function yieldToNextFrame() {
+    if (typeof requestAnimationFrame !== "function")
+        return Promise.resolve();
+    return new Promise((resolve) => requestAnimationFrame(() => resolve()));
+}
+async function yieldUntilAfterPaint() {
+    await yieldToNextFrame();
+    await yieldToNextFrame();
+}
+/**
+ * Parse a GLTF URL once for the lifetime of the page.
+ *
+ * Performer rigs frequently use the same avatar and locomotion files. Browser
+ * caching avoids another download, but GLTFLoader would still parse the same
+ * binary again for every performer. Keeping the parsed result here removes
+ * that repeated main-thread work. A failed request is evicted so retry still
+ * works after a temporary network problem.
+ */
+export function loadSharedGltf(url) {
+    const existing = loads.get(url);
+    if (existing)
+        return existing;
+    const parseStart = performance.now();
+    const pending = loader.loadAsync(url).then(async (gltf) => {
+        recordAvatarLoadSpan(avatarAssetLabel(url), "gltf-fetch-parse", parseStart);
+        const fitStart = performance.now();
+        await fitAvatarTexturesToDisplayBudget(gltf.scene);
+        recordAvatarLoadSpan(avatarAssetLabel(url), "texture-downscale", fitStart);
+        const box = new Box3().setFromObject(gltf.scene);
+        avatarBounds.set(url, {
+            height: box.max.y - box.min.y,
+            minY: box.min.y,
+        });
+        return gltf;
+    });
+    loads.set(url, pending);
+    void pending.catch(() => {
+        if (loads.get(url) === pending)
+            loads.delete(url);
+    });
+    return pending;
+}
+/**
+ * The authored character GLBs include desktop-production 4K PNGs. A single
+ * avatar can otherwise allocate hundreds of megabytes and block the WebGL
+ * driver for several frames when selected. Resize those decoded images once,
+ * before any instance reaches the renderer. The shared textures and all later
+ * clones retain the same color-space and material configuration.
+ */
+async function fitAvatarTexturesToDisplayBudget(root) {
+    if (typeof createImageBitmap !== "function")
+        return;
+    const texturesByImage = new Map();
+    for (const texture of collectTextures(root)) {
+        const image = texture.image;
+        if (!image)
+            continue;
+        const siblings = texturesByImage.get(image);
+        if (siblings)
+            siblings.push(texture);
+        else
+            texturesByImage.set(image, [texture]);
+    }
+    await Promise.all([...texturesByImage].map(async ([image, imageTextures]) => {
+        const source = image;
+        const width = source.width ?? source.naturalWidth ?? 0;
+        const height = source.height ?? source.naturalHeight ?? 0;
+        const largestDimension = Math.max(width, height);
+        if (largestDimension <= MAX_AVATAR_TEXTURE_DIMENSION)
+            return;
+        const scale = MAX_AVATAR_TEXTURE_DIMENSION / largestDimension;
+        const resized = await createImageBitmap(source, {
+            resizeWidth: Math.max(1, Math.round(width * scale)),
+            resizeHeight: Math.max(1, Math.round(height * scale)),
+            resizeQuality: "high",
+        });
+        for (const texture of imageTextures) {
+            texture.image = resized;
+            texture.needsUpdate = true;
+        }
+        source.close?.();
+    }));
+}
+function collectTextures(root) {
+    const textures = new Set();
+    root.traverse((child) => {
+        const mesh = child;
+        if (!mesh.material)
+            return;
+        const materials = Array.isArray(mesh.material)
+            ? mesh.material
+            : [mesh.material];
+        for (const material of materials) {
+            for (const value of Object.values(material)) {
+                if (value?.isTexture) {
+                    textures.add(value);
+                }
+            }
+        }
+    });
+    return [...textures];
+}
+/**
+ * Parse an avatar before another performer needs it.
+ *
+ * The first visible performer starts this work. Later performers then clone
+ * the prepared scene instead of briefly showing a stand-in while the same
+ * model is parsed again.
+ */
+export function prepareSharedGltf(url) {
+    return loadSharedGltf(url).then(() => undefined);
+}
+/** Reuse source-pose bounds instead of traversing a prepared clone on click. */
+export function getSharedGltfBounds(url) {
+    return avatarBounds.get(url) ?? null;
+}
+/**
+ * Register a live renderer that can prepare avatar shaders and textures on
+ * intent. Multiple Avatar3D instances in one canvas share one context.
+ */
+export function registerAvatarRenderWarmup(renderer, scene, getCamera) {
+    const existing = avatarRenderContexts.get(renderer);
+    if (existing) {
+        existing.references++;
+        existing.getCamera = getCamera;
+    }
+    else {
+        avatarRenderContexts.set(renderer, {
+            renderer,
+            scene,
+            getCamera,
+            references: 1,
+            warmups: new Map(),
+            preparedRoots: new Map(),
+            preparedUrls: new Set(),
+        });
+    }
+    return () => {
+        const context = avatarRenderContexts.get(renderer);
+        if (!context)
+            return;
+        context.references--;
+        if (context.references > 0)
+            return;
+        for (const root of context.preparedRoots.values()) {
+            disposeWarmAvatarRoot(root);
+        }
+        avatarRenderContexts.delete(renderer);
+    };
+}
+function disposeWarmAvatarRoot(root) {
+    const skeletons = new Set();
+    root.traverse((child) => {
+        const mesh = child;
+        if (mesh.skeleton)
+            skeletons.add(mesh.skeleton);
+        if (!mesh.material)
+            return;
+        if (Array.isArray(mesh.material)) {
+            mesh.material.forEach((material) => material.dispose());
+        }
+        else {
+            mesh.material.dispose();
+        }
+    });
+    skeletons.forEach((skeleton) => skeleton.dispose());
+}
+async function warmAvatarForRenderer(context, root, label) {
+    const camera = context.getCamera();
+    if (!camera)
+        return;
+    const compileStart = performance.now();
+    await context.renderer.compileAsync(root, camera, context.scene);
+    recordAvatarLoadSpan(label, "intent-shader-compile", compileStart);
+    // Upload one decoded texture per painted frame. WebGLRenderer.initTexture()
+    // leaves the live framebuffer, viewport, and scene untouched, so moving
+    // across avatar choices cannot flash a one-pixel target onto the stage.
+    const uploadStart = performance.now();
+    const textures = collectTextures(root);
+    for (const texture of textures) {
+        context.renderer.initTexture(texture);
+        await yieldToNextFrame();
+    }
+    recordAvatarLoadSpan(label, "intent-texture-upload", uploadStart, `${textures.length} textures`);
+}
+/**
+ * Parse and upload an avatar when pointer or keyboard intent is known.
+ * Failed hints are evicted so the normal visible load can still retry.
+ */
+export async function prepareAvatarForDisplay(url) {
+    const gltf = await loadSharedGltf(url);
+    await Promise.all([...avatarRenderContexts.values()].map((context) => {
+        const existing = context.warmups.get(url);
+        if (existing)
+            return existing;
+        const preparedRoot = cloneSharedSkinnedScene(gltf.scene);
+        preparedRoot.traverse((child) => {
+            const mesh = child;
+            if (mesh.isMesh)
+                mesh.castShadow = true;
+        });
+        const pending = warmAvatarForRenderer(context, preparedRoot, avatarAssetLabel(url))
+            .then(() => {
+            context.preparedRoots.set(url, preparedRoot);
+            context.preparedUrls.add(url);
+        })
+            .catch((error) => {
+            if (context.warmups.get(url) === pending) {
+                context.warmups.delete(url);
+                context.preparedRoots.delete(url);
+                disposeWarmAvatarRoot(preparedRoot);
+            }
+            throw error;
+        });
+        context.warmups.set(url, pending);
+        return pending;
+    }));
+}
+/** Whether a URL's shaders and shared textures are ready for this renderer. */
+export function isAvatarPreparedForRenderer(url, renderer) {
+    return avatarRenderContexts.get(renderer)?.preparedUrls.has(url) ?? false;
+}
+/** Transfer a completed intent warmup to the avatar instance that requested it. */
+export function takePreparedAvatarRoot(url, renderer) {
+    const contexts = renderer
+        ? [avatarRenderContexts.get(renderer)].filter((context) => Boolean(context))
+        : [...avatarRenderContexts.values()];
+    for (const context of contexts) {
+        const root = context.preparedRoots.get(url);
+        if (!root)
+            continue;
+        context.preparedRoots.delete(url);
+        return root;
+    }
+    return null;
+}
+/**
+ * Parse an animation GLB once without retaining the file's embedded scene.
+ *
+ * Mixamo animation exports often include a complete character alongside the
+ * clip. Keeping the entire GLTF for every locomotion asset costs hundreds of
+ * megabytes. This cache retains only the immutable AnimationClip shared by
+ * every performer and lets the unused scene graph be collected.
+ */
+export function loadSharedAnimation(url) {
+    const existing = animationLoads.get(url);
+    if (existing)
+        return existing;
+    const pending = loader.loadAsync(url).then((gltf) => {
+        const clip = gltf.animations[0];
+        if (!clip)
+            throw new Error(`No animation in ${url}`);
+        // Read the feet before the character carrying them is dropped. A clip is a
+        // set of joint angles and says nothing about where the feet went; only the
+        // rig it was authored on can answer that, and that rig is alive for
+        // exactly this long.
+        const footprint = extractClipFootprint(gltf.scene, clip);
+        if (footprint)
+            registerClipFootprint(clip, footprint);
+        return clip;
+    });
+    animationLoads.set(url, pending);
+    void pending.catch(() => {
+        if (animationLoads.get(url) === pending)
+            animationLoads.delete(url);
+    });
+    return pending;
+}
+/** Share existence probes used before optional animation packs are loaded. */
+export function checkSharedAssetAvailability(url) {
+    const existing = availabilityChecks.get(url);
+    if (existing)
+        return existing;
+    const pending = fetch(url, { method: "HEAD" }).then((response) => {
+        const contentType = response.headers.get("content-type") ?? "";
+        return response.ok && !contentType.includes("text/html");
+    });
+    availabilityChecks.set(url, pending);
+    void pending.catch(() => {
+        if (availabilityChecks.get(url) === pending)
+            availabilityChecks.delete(url);
+    });
+    return pending;
+}
+/**
+ * Spread independent performer setup across frames in mount order.
+ *
+ * Svelte mounts every new rig synchronously. Serializing the heavy clone and
+ * mixer setup keeps a batch add from becoming one long main-thread task while
+ * the light state change and formation motion remain immediate.
+ */
+let performerInitializationQueue = Promise.resolve();
+export async function schedulePerformerInitialization(initialize, label = "performer") {
+    const predecessor = performerInitializationQueue;
+    let release;
+    performerInitializationQueue = new Promise((resolve) => {
+        release = resolve;
+    });
+    try {
+        const queuedAt = performance.now();
+        await predecessor;
+        recordAvatarLoadSpan(label, "init-queue-wait", queuedAt);
+        const yieldStart = performance.now();
+        await yieldUntilAfterPaint();
+        recordAvatarLoadSpan(label, "init-paint-yield", yieldStart);
+        const workStart = performance.now();
+        try {
+            return await initialize();
+        }
+        finally {
+            recordAvatarLoadSpan(label, "init-work", workStart);
+        }
+    }
+    finally {
+        release();
+    }
+}
+/**
+ * Mount one expensive performer subtree after the browser has painted.
+ *
+ * The callback is intentionally synchronous: it only opens a Svelte render
+ * gate. Avatar parsing has its own async initialization queue above. Keeping
+ * these queues separate prevents a network request from delaying the next
+ * performer's lightweight shell while still limiting WebGL setup to one
+ * subtree per painted frame.
+ */
+let performerMountQueue = Promise.resolve();
+export async function schedulePerformerMount(mount, label = "performer") {
+    const predecessor = performerMountQueue;
+    let release;
+    performerMountQueue = new Promise((resolve) => {
+        release = resolve;
+    });
+    try {
+        const queuedAt = performance.now();
+        await predecessor;
+        recordAvatarLoadSpan(label, "mount-queue-wait", queuedAt);
+        const yieldStart = performance.now();
+        await yieldUntilAfterPaint();
+        recordAvatarLoadSpan(label, "mount-paint-yield", yieldStart);
+        mount();
+    }
+    finally {
+        release();
+    }
+}
+/**
+ * Give one performer an independently animatable skeleton while sharing the
+ * immutable geometry and textures from the parsed model. Materials are cloned
+ * because performer fades and customization mutate opacity and color.
+ */
+export function cloneSharedSkinnedScene(source) {
+    const scene = cloneSkinned(source);
+    scene.traverse((child) => {
+        const mesh = child;
+        if (!mesh.isMesh || !mesh.material)
+            return;
+        mesh.material = Array.isArray(mesh.material)
+            ? mesh.material.map((material) => material.clone())
+            : mesh.material.clone();
+    });
+    return scene;
+}
+/** Test-only reset for proving retry and deduplication behavior. */
+export function clearSharedGltfCache() {
+    loads.clear();
+    animationLoads.clear();
+    availabilityChecks.clear();
+    performerInitializationQueue = Promise.resolve();
+    performerMountQueue = Promise.resolve();
+    for (const context of avatarRenderContexts.values()) {
+        context.warmups.clear();
+        for (const root of context.preparedRoots.values()) {
+            disposeWarmAvatarRoot(root);
+        }
+        context.preparedRoots.clear();
+    }
+}
