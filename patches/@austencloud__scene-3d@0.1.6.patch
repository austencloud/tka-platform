+  footprint: ClipFootprint,
+  root: Object3D,
+  prefix: string,
+  rig: Rig
+): AnimationClip {
+  const samples = footprint.samples;
+  const step = clip.duration / (samples - 1);
+  const times = new Float32Array(samples);
+  const values = new Map<string, Float32Array>();
+  for (const name of BAKED)
+    values.set(`${prefix}${name}.quaternion`, new Float32Array(samples * 4));
