+  target.moveTo(px(contour.start[0]), py(contour.start[1]));
+  for (const [c1x, c1y, c2x, c2y, x, y] of contour.curves) {
+    target.bezierCurveTo(px(c1x), py(c1y), px(c2x), py(c2y), px(x), py(y));
