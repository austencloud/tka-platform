+    // leaves the live framebuffer, viewport, and scene untouched, so moving
+    // across avatar choices cannot flash a one-pixel target onto the stage.
+    for (const texture of collectTextures(root)) {
+        context.renderer.initTexture(texture);
+        await yieldToNextFrame();
+    }
+}
+/**
+ * Parse and upload an avatar when pointer or keyboard intent is known.
+ * Failed hints are evicted so the normal visible load can still retry.
+ */
+export async function prepareAvatarForDisplay(url) {
+    const gltf = await loadSharedGltf(url);
+    await Promise.all([...avatarRenderContexts.values()].map((context) => {
+        const existing = context.warmups.get(url);
+        if (existing)
+            return existing;
+        const preparedRoot = cloneSharedSkinnedScene(gltf.scene);
+        preparedRoot.traverse((child) => {
+            const mesh = child;
+            if (mesh.isMesh)
+                mesh.castShadow = true;
+        });
+        const pending = warmAvatarForRenderer(context, preparedRoot)
+            .then(() => {
+            context.preparedRoots.set(url, preparedRoot);
+            context.preparedUrls.add(url);
+        })
+            .catch((error) => {
+            if (context.warmups.get(url) === pending) {
+                context.warmups.delete(url);
+                context.preparedRoots.delete(url);
+                disposeWarmAvatarRoot(preparedRoot);
+            }
+            throw error;
+        });
+        context.warmups.set(url, pending);
+        return pending;
+    }));
+}
+/** Whether a URL's shaders and shared textures are ready for this renderer. */
+export function isAvatarPreparedForRenderer(url, renderer) {
+    return avatarRenderContexts.get(renderer)?.preparedUrls.has(url) ?? false;
+}
+/** Transfer a completed intent warmup to the avatar instance that requested it. */
+export function takePreparedAvatarRoot(url, renderer) {
+    const contexts = renderer
+        ? [avatarRenderContexts.get(renderer)].filter((context) => Boolean(context))
+        : [...avatarRenderContexts.values()];
+    for (const context of contexts) {
+        const root = context.preparedRoots.get(url);
+        if (!root)
+            continue;
+        context.preparedRoots.delete(url);
+        return root;
+    }
+    return null;
+}
+/**
+ * Parse an animation GLB once without retaining the file's embedded scene.
+ *
+ * Mixamo animation exports often include a complete character alongside the
+ * clip. Keeping the entire GLTF for every locomotion asset costs hundreds of
+ * megabytes. This cache retains only the immutable AnimationClip shared by
+ * every performer and lets the unused scene graph be collected.
+ */
+export function loadSharedAnimation(url) {
+    const existing = animationLoads.get(url);
+    if (existing)
+        return existing;
+    const pending = loader.loadAsync(url).then((gltf) => {
+        const clip = gltf.animations[0];
+        if (!clip)
+            throw new Error(`No animation in ${url}`);
+        return clip;
+    });
+    animationLoads.set(url, pending);
+    void pending.catch(() => {
+        if (animationLoads.get(url) === pending)
+            animationLoads.delete(url);
+    });
+    return pending;
+}
+/** Share existence probes used before optional animation packs are loaded. */
+export function checkSharedAssetAvailability(url) {
+    const existing = availabilityChecks.get(url);
+    if (existing)
+        return existing;
+    const pending = fetch(url, { method: "HEAD" }).then((response) => {
+        const contentType = response.headers.get("content-type") ?? "";
+        return response.ok && !contentType.includes("text/html");
+    });
+    availabilityChecks.set(url, pending);
+    void pending.catch(() => {
+        if (availabilityChecks.get(url) === pending)
+            availabilityChecks.delete(url);
+    });
+    return pending;
+}
+/**
+ * Spread independent performer setup across frames in mount order.
+ *
+ * Svelte mounts every new rig synchronously. Serializing the heavy clone and
+ * mixer setup keeps a batch add from becoming one long main-thread task while
+ * the light state change and formation motion remain immediate.
+ */
+let performerInitializationQueue = Promise.resolve();
+export async function schedulePerformerInitialization(initialize) {
+    const predecessor = performerInitializationQueue;
+    let release;
+    performerInitializationQueue = new Promise((resolve) => {
+        release = resolve;
+    });
+    try {
+        await predecessor;
+        await yieldUntilAfterPaint();
+        return await initialize();
+    }
+    finally {
+        release();
+    }
+}
+/**
+ * Mount one expensive performer subtree after the browser has painted.
+ *
+ * The callback is intentionally synchronous: it only opens a Svelte render
+ * gate. Avatar parsing has its own async initialization queue above. Keeping
+ * these queues separate prevents a network request from delaying the next
+ * performer's lightweight shell while still limiting WebGL setup to one
+ * subtree per painted frame.
+ */
+let performerMountQueue = Promise.resolve();
+export async function schedulePerformerMount(mount) {
+    const predecessor = performerMountQueue;
+    let release;
+    performerMountQueue = new Promise((resolve) => {
+        release = resolve;
+    });
+    try {
+        await predecessor;
+        await yieldUntilAfterPaint();
+        mount();
+    }
+    finally {
+        release();
+    }
+}
+/**
+ * Give one performer an independently animatable skeleton while sharing the
+ * immutable geometry and textures from the parsed model. Materials are cloned
+ * because performer fades and customization mutate opacity and color.
+ */
+export function cloneSharedSkinnedScene(source) {
+    const scene = cloneSkinned(source);
+    scene.traverse((child) => {
+        const mesh = child;
+        if (!mesh.isMesh || !mesh.material)
+            return;
+        mesh.material = Array.isArray(mesh.material)
+            ? mesh.material.map((material) => material.clone())
+            : mesh.material.clone();
+    });
+    return scene;
+}
+/** Test-only reset for proving retry and deduplication behavior. */
+export function clearSharedGltfCache() {
+    loads.clear();
+    animationLoads.clear();
+    availabilityChecks.clear();
+    performerInitializationQueue = Promise.resolve();
+    performerMountQueue = Promise.resolve();
+    for (const context of avatarRenderContexts.values()) {
+        context.warmups.clear();
+        for (const root of context.preparedRoots.values()) {
+            disposeWarmAvatarRoot(root);
+        }
+        context.preparedRoots.clear();
+    }
+}
