+    // Bend the knees the way the performer faces. A world +Z pole bends the
+    // knee backwards for anyone facing south, and choreography sends them
+    // around the whole compass.
+    rig.hips.getWorldQuaternion(spin);
+    pole.set(0, 0, 1).applyQuaternion(spin);
+    pole.y = 0;
+    if (pole.lengthSq() < 1e-6) pole.set(0, 0, 1);
+    pole.normalize();
