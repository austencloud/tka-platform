+import { Box3 } from "three";
+import { GLTFLoader, } from "three/examples/jsm/loaders/GLTFLoader.js";
+import { clone as cloneSkinned } from "three/examples/jsm/utils/SkeletonUtils.js";
+const loader = new GLTFLoader();
+const loads = new Map();
+const animationLoads = new Map();
+const availabilityChecks = new Map();
+const avatarBounds = new Map();
+const MAX_AVATAR_TEXTURE_DIMENSION = 1024;
+const avatarRenderContexts = new Map();
+function yieldToNextFrame() {
+    if (typeof requestAnimationFrame !== "function")
+        return Promise.resolve();
+    return new Promise((resolve) => requestAnimationFrame(() => resolve()));
+}
+async function yieldUntilAfterPaint() {
+    await yieldToNextFrame();
+    await yieldToNextFrame();
+}
+/**
+ * Parse a GLTF URL once for the lifetime of the page.
+ *
+ * Performer rigs frequently use the same avatar and locomotion files. Browser
+ * caching avoids another download, but GLTFLoader would still parse the same
+ * binary again for every performer. Keeping the parsed result here removes
+ * that repeated main-thread work. A failed request is evicted so retry still
+ * works after a temporary network problem.
+ */
+export function loadSharedGltf(url) {
+    const existing = loads.get(url);
+    if (existing)
+        return existing;
+    const pending = loader.loadAsync(url).then(async (gltf) => {
+        await fitAvatarTexturesToDisplayBudget(gltf.scene);
+        const box = new Box3().setFromObject(gltf.scene);
+        avatarBounds.set(url, {
+            height: box.max.y - box.min.y,
+            minY: box.min.y,
+        });
+        return gltf;
+    });
+    loads.set(url, pending);
+    void pending.catch(() => {
+        if (loads.get(url) === pending)
+            loads.delete(url);
+    });
+    return pending;
+}
+/**
+ * The authored character GLBs include desktop-production 4K PNGs. A single
+ * avatar can otherwise allocate hundreds of megabytes and block the WebGL
+ * driver for several frames when selected. Resize those decoded images once,
+ * before any instance reaches the renderer. The shared textures and all later
+ * clones retain the same color-space and material configuration.
+ */
+async function fitAvatarTexturesToDisplayBudget(root) {
+    if (typeof createImageBitmap !== "function")
+        return;
+    const texturesByImage = new Map();
+    for (const texture of collectTextures(root)) {
+        const image = texture.image;
+        if (!image)
+            continue;
+        const siblings = texturesByImage.get(image);
+        if (siblings)
+            siblings.push(texture);
+        else
+            texturesByImage.set(image, [texture]);
+    }
+    await Promise.all([...texturesByImage].map(async ([image, imageTextures]) => {
+        const source = image;
+        const width = source.width ?? source.naturalWidth ?? 0;
+        const height = source.height ?? source.naturalHeight ?? 0;
+        const largestDimension = Math.max(width, height);
+        if (largestDimension <= MAX_AVATAR_TEXTURE_DIMENSION)
+            return;
+        const scale = MAX_AVATAR_TEXTURE_DIMENSION / largestDimension;
+        const resized = await createImageBitmap(source, {
+            resizeWidth: Math.max(1, Math.round(width * scale)),
+            resizeHeight: Math.max(1, Math.round(height * scale)),
+            resizeQuality: "high",
+        });
+        for (const texture of imageTextures) {
+            texture.image = resized;
+            texture.needsUpdate = true;
+        }
+        source.close?.();
+    }));
+}
+function collectTextures(root) {
+    const textures = new Set();
+    root.traverse((child) => {
+        const mesh = child;
+        if (!mesh.material)
+            return;
+        const materials = Array.isArray(mesh.material)
+            ? mesh.material
+            : [mesh.material];
+        for (const material of materials) {
+            for (const value of Object.values(material)) {
+                if (value?.isTexture) {
+                    textures.add(value);
+                }
+            }
+        }
+    });
+    return [...textures];
+}
+/**
+ * Parse an avatar before another performer needs it.
+ *
+ * The first visible performer starts this work. Later performers then clone
+ * the prepared scene instead of briefly showing a stand-in while the same
+ * model is parsed again.
+ */
+export function prepareSharedGltf(url) {
+    return loadSharedGltf(url).then(() => undefined);
+}
+/** Reuse source-pose bounds instead of traversing a prepared clone on click. */
+export function getSharedGltfBounds(url) {
+    return avatarBounds.get(url) ?? null;
+}
+/**
+ * Register a live renderer that can prepare avatar shaders and textures on
+ * intent. Multiple Avatar3D instances in one canvas share one context.
+ */
+export function registerAvatarRenderWarmup(renderer, scene, getCamera) {
+    const existing = avatarRenderContexts.get(renderer);
+    if (existing) {
+        existing.references++;
+        existing.getCamera = getCamera;
+    }
+    else {
+        avatarRenderContexts.set(renderer, {
+            renderer,
+            scene,
+            getCamera,
+            references: 1,
+            warmups: new Map(),
+            preparedRoots: new Map(),
+            preparedUrls: new Set(),
+        });
+    }
+    return () => {
+        const context = avatarRenderContexts.get(renderer);
+        if (!context)
+            return;
+        context.references--;
+        if (context.references > 0)
+            return;
+        for (const root of context.preparedRoots.values()) {
+            disposeWarmAvatarRoot(root);
+        }
+        avatarRenderContexts.delete(renderer);
+    };
