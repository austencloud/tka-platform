+  TRIQUETRA2_GRIP,
+  TRIQUETRA2_GRIP_OFFSET,
+  TRIQUETRA_CUSP_GAP,
+  TRIQUETRA_GRIP,
+  TRIQUETRA_RIBBON_WIDTH,
+  buildTriquetraShape,
+  buildTriquetraShapes
+};
