+  const toLocal = new Matrix4().copy(frame.matrixWorld).invert();
+  const hip = chain.root.getWorldPosition(new Vector3()).applyMatrix4(toLocal);
+  const knee = chain.middle
+    .getWorldPosition(new Vector3())
+    .applyMatrix4(toLocal);
+  const ankle = chain.effector
+    .getWorldPosition(new Vector3())
+    .applyMatrix4(toLocal);
