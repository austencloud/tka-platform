+  root.updateMatrixWorld(true);
+  const calibrator = new KneeHingeAxisCalibrator();
+  const build = (side: "Left" | "Right"): Omit<Side, "track"> | null => {
+    const upper = bone(`${side}UpLeg`);
+    const knee = bone(`${side}Leg`);
+    const ankle = bone(`${side}Foot`);
+    if (!upper || !knee || !ankle) return null;
+    const chain = buildTwoBoneChain(upper, knee, ankle);
+    return {
+      chain,
+      toe: bone(`${side}ToeBase`),
+      hinge: calibrator.compute(chain.rootRestDir, chain.middleRestDir),
+    };
+  };
+
+  const left = build("Left");
+  const right = build("Right");
+  if (!left || !right) return null;
+  if (!(left.chain.totalLength > 0)) return null;
