+
+export interface ContactRetargetOptions {
+  /**
+   * Minimum left-to-right ankle order as a share of hip-joint spacing.
+   *
+   * Lateral maneuvers use this to reject the retargeting failure where a
+   * narrow-hipped target turns a near-touching source pose into self-
