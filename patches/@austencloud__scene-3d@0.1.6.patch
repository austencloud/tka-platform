+function loadContactSidecar(url: string): Promise<ContactSidecar> {
+  const existing = contactSidecarLoads.get(url);
+  if (existing) return existing;
+
+  const pending = fetch(url).then(async (response) => {
+    if (!response.ok) throw new Error(`HTTP ${response.status}`);
+    return (await response.json()) as ContactSidecar;
+  });
+  contactSidecarLoads.set(url, pending);
+  void pending.catch(() => {
+    if (contactSidecarLoads.get(url) === pending) {
+      contactSidecarLoads.delete(url);
+    }
+  });
+  return pending;
