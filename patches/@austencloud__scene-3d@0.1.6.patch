@@ -0,0 +1,54 @@
+/**
+ * Avatar load instrumentation.
+ *
+ * Records how long each phase of bringing a performer's avatar on screen
+ * takes - global queue waits, paint yields, GLB parse, texture downscale,
+ * skinned clone, skeleton build, shader compile, texture upload - so a slow
+ * scene can be diagnosed from a per-performer, per-phase breakdown instead
+ * of a feeling. Recording is always on and costs one array push per span.
+ *
+ * Read the data from DevTools:
+ *   __avatarLoadReport()  - per-label phase table + wall-clock window
+ *   __avatarLoadEvents()  - raw spans in record order
+ *   __avatarLoadClear()   - reset between measurements
+ *
+ * Every span is also emitted as a performance.measure entry named
+ * "avatar:<phase>:<label>", so the DevTools Performance timeline shows the
+ * same story alongside frames and GC.
+ */
+export interface AvatarLoadSpan {
+    /** Which performer or asset this span belongs to. */
+    label: string;
+    /** Pipeline phase, e.g. "init-queue-wait", "shader-compile". */
+    phase: string;
+    /** performance.now() when the phase began. */
+    start: number;
+    durationMs: number;
+    /** Optional context: cache-hit/cold, texture counts, and similar. */
+    detail?: string;
+}
+/** Distinguish rigs that share one avatar model: "hoodie@3", "hoodie@4". */
+export declare function nextAvatarInstrumentationSequence(): number;
+/** "https://host/models/avatars/hoodie.glb" -> "hoodie.glb" */
+export declare function avatarAssetLabel(url: string): string;
+export declare function recordAvatarLoadSpan(label: string, phase: string, start: number, detail?: string): number;
+/** Time an async or sync phase and record it even when it throws. */
+export declare function timeAvatarLoadPhase<T>(label: string, phase: string, run: () => Promise<T> | T, detail?: string): Promise<T>;
+export declare function getAvatarLoadSpans(): readonly AvatarLoadSpan[];
+export declare function clearAvatarLoadSpans(): void;
+export interface AvatarLoadSummaryRow {
+    label: string;
+    phase: string;
+    count: number;
+    totalMs: number;
+    maxMs: number;
+    detail?: string;
+}
+export interface AvatarLoadSummary {
+    rows: AvatarLoadSummaryRow[];
+    /** Wall-clock from the first span's start to the last span's end. */
+    windowMs: number;
+    /** Summed span durations; exceeds windowMs when phases overlap. */
+    busyMs: number;
+}
+export declare function summarizeAvatarLoadSpans(): AvatarLoadSummary;
diff --git a/dist/lib/debug/avatar-load-instrumentation.js b/dist/lib/debug/avatar-load-instrumentation.js
new file mode 100644
index 0000000000000000000000000000000000000000..3da407076bbad414d93cdac0dd1f84ba44abfb56
--- /dev/null
+++ b/dist/lib/debug/avatar-load-instrumentation.js
@@ -0,0 +1,121 @@
+/**
+ * Avatar load instrumentation.
+ *
+ * Records how long each phase of bringing a performer's avatar on screen
+ * takes - global queue waits, paint yields, GLB parse, texture downscale,
+ * skinned clone, skeleton build, shader compile, texture upload - so a slow
+ * scene can be diagnosed from a per-performer, per-phase breakdown instead
+ * of a feeling. Recording is always on and costs one array push per span.
+ *
+ * Read the data from DevTools:
+ *   __avatarLoadReport()  - per-label phase table + wall-clock window
+ *   __avatarLoadEvents()  - raw spans in record order
+ *   __avatarLoadClear()   - reset between measurements
+ *
+ * Every span is also emitted as a performance.measure entry named
+ * "avatar:<phase>:<label>", so the DevTools Performance timeline shows the
+ * same story alongside frames and GC.
+ */
+const spans = [];
+let instanceSequence = 0;
+/** Distinguish rigs that share one avatar model: "hoodie@3", "hoodie@4". */
+export function nextAvatarInstrumentationSequence() {
+    return ++instanceSequence;
+}
+/** "https://host/models/avatars/hoodie.glb" -> "hoodie.glb" */
+export function avatarAssetLabel(url) {
+    return url.slice(url.lastIndexOf("/") + 1) || url;
+}
+export function recordAvatarLoadSpan(label, phase, start, detail) {
+    const durationMs = performance.now() - start;
+    spans.push({ label, phase, start, durationMs, detail });
+    try {
+        performance.measure(`avatar:${phase}:${label}`, {
+            start,
+            end: start + durationMs,
+        });
+    }
+    catch {
+        // Older measure() signatures reject the options object; the table and
+        // raw spans still carry the data.
+    }
+    return durationMs;
+}
+/** Time an async or sync phase and record it even when it throws. */
+export async function timeAvatarLoadPhase(label, phase, run, detail) {
+    const start = performance.now();
+    try {
+        return await run();
+    }
+    finally {
+        recordAvatarLoadSpan(label, phase, start, detail);
+    }
+}
+export function getAvatarLoadSpans() {
+    return spans;
+}
+export function clearAvatarLoadSpans() {
+    spans.length = 0;
+}
+export function summarizeAvatarLoadSpans() {
+    const byKey = new Map();
+    let windowStart = Infinity;
+    let windowEnd = -Infinity;
+    let busyMs = 0;
+    for (const span of spans) {
+        windowStart = Math.min(windowStart, span.start);
+        windowEnd = Math.max(windowEnd, span.start + span.durationMs);
+        busyMs += span.durationMs;
+        const key = `${span.label} ${span.phase}`;
+        const row = byKey.get(key);
+        if (row) {
+            row.count++;
+            row.totalMs += span.durationMs;
+            row.maxMs = Math.max(row.maxMs, span.durationMs);
+            if (span.detail)
+                row.detail = span.detail;
+        }
+        else {
+            byKey.set(key, {
+                label: span.label,
+                phase: span.phase,
+                count: 1,
+                totalMs: span.durationMs,
+                maxMs: span.durationMs,
+                detail: span.detail,
+            });
+        }
+    }
+    return {
+        rows: [...byKey.values()],
+        windowMs: spans.length ? windowEnd - windowStart : 0,
+        busyMs,
+    };
+}
+function reportAvatarLoad() {
+    const summary = summarizeAvatarLoadSpans();
+    const round = (value) => Math.round(value * 10) / 10;
+    console.table(summary.rows.map((row) => ({
+        label: row.label,
+        phase: row.phase,
+        count: row.count,
+        totalMs: round(row.totalMs),
+        maxMs: round(row.maxMs),
+        detail: row.detail ?? "",
+    })));
+    const phaseTotals = new Map();
+    for (const row of summary.rows) {
+        phaseTotals.set(row.phase, (phaseTotals.get(row.phase) ?? 0) + row.totalMs);
+    }
+    console.table([...phaseTotals]
+        .sort((a, b) => b[1] - a[1])
+        .map(([phase, totalMs]) => ({ phase, totalMs: round(totalMs) })));
+    console.log(`avatar load window ${round(summary.windowMs)}ms, summed phases ${round(summary.busyMs)}ms, spans ${spans.length}`);
+    return summary;
+}
+if (typeof window !== "undefined") {
+    const w = window;
+    w.__avatarLoadReport = reportAvatarLoad;
+    w.__avatarLoadEvents = () => spans.slice();
+    w.__avatarLoadClear = clearAvatarLoadSpans;
+}
