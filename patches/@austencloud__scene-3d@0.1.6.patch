+    start: [0.20411, 0.22903],
+    curves: [
+        [0.19422, 0.22389, 0.17089, 0.21084, 0.14557, 0.19462],
+        [0.12025, 0.1788, 0.09296, 0.16021, 0.07437, 0.14557],
+        [0.12553, 0.22679, 0.17669, 0.30802, 0.22785, 0.38924],
