+      { at: 0.01384, radius: 0.01355 },
+    ],
+  },
+  {
+    id: "grip",
+    stops: [
+      { at: 0.01384, radius: 0.01355 },
+      { at: 0.03659, radius: 0.01335 },
+      { at: 0.10285, radius: 0.01375 },
+      { at: 0.19976, radius: 0.01493 },
+      { at: 0.24031, radius: 0.0177 },
+      { at: 0.24426, radius: 0.01859 },
+    ],
+  },
+  {
