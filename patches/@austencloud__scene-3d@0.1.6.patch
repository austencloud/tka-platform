+    depth: depth * STRAIGHT_FRACTION,
+    bevelEnabled: true,
+    bevelThickness: bevel,
+    bevelSize: Math.min(bevel, maxInset),
+    bevelOffset: 0,
+    bevelSegments: 5,
+    curveSegments,
+  });
