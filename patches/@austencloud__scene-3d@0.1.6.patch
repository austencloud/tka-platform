+import { PropType } from "../domain/enums/PropType";
+class PropFinishState {
+  _finish = $state("fire");
+  get finish() {
+    return this._finish;
+  }
+  set(finish) {
+    this._finish = finish;
+  }
+  toggle() {
+    this._finish = this._finish === "fire" ? "day" : "fire";
+  }
+}
+const propFinishState = new PropFinishState();
+const PROPS_WITH_FINISH_VARIANTS = /* @__PURE__ */ new Set([
+  PropType.TRIAD,
+  PropType.BIGTRIAD,
+  PropType.QUIAD
+]);
+function propHasFinishVariants(propType) {
+  return PROPS_WITH_FINISH_VARIANTS.has(propType);
+}
+export {
+  propFinishState,
+  propHasFinishVariants
+};
