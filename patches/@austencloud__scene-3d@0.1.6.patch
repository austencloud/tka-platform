+<script module lang="ts">
+  import {
+    CylinderGeometry,
+    MeshBasicMaterial,
+    MeshStandardMaterial,
+    SphereGeometry,
+    TorusGeometry,
+  } from "three";
+
+  interface StaffGeometrySet {
+    shaft: CylinderGeometry;
+    tBar: CylinderGeometry;
+    tBarCap: SphereGeometry;
+    endCap: SphereGeometry;
+    grip: TorusGeometry;
+  }
+
+  interface StaffMaterialSet {
+    main: MeshStandardMaterial;
+    dark: MeshStandardMaterial;
+    grip: MeshStandardMaterial;
+    trail: MeshBasicMaterial;
+  }
+
+  const geometrySets = new Map<string, StaffGeometrySet>();
+  const materialSets = new Map<"blue" | "red", StaffMaterialSet>();
+
+  function getStaffGeometrySet(
+    length: number,
+    thickness: number
+  ): StaffGeometrySet {
+    const key = `${length}:${thickness}`;
+    const cached = geometrySets.get(key);
+    if (cached) return cached;
+
+    const tBarLength = length * 0.228;
+    const geometry = {
+      shaft: new CylinderGeometry(thickness, thickness, length, 16, 1),
