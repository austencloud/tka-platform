+
+/** The lowest point of the front of the foot, in `toSpace`. */
+function lowestFootPoint(
+  toe: Object3D,
+  toSpace: Matrix4,
+  into: Vector3
+): boolean {
+  let found = false;
+  for (const part of [toe, ...toe.children]) {
+    part.getWorldPosition(toeLocal).applyMatrix4(toSpace);
+    if (!found || toeLocal.y < into.y) {
+      into.copy(toeLocal);
+      found = true;
+    }
+  }
+  return found;
+}
+
+/** Turn one footprint sample into a point in the target rig's own space. */
+function read(
+  into: Vector3,
+  track: Float32Array,
+  index: number,
+  origin: Vector3,
+  legLength: number
+): void {
+  into.set(
+    origin.x + track[index * 3]! * legLength,
+    origin.y + track[index * 3 + 1]! * legLength,
+    origin.z + track[index * 3 + 2]! * legLength
+  );
+}
+
+interface CapturedBone {
+  object: Object3D;
+  position: Vector3;
+  quaternion: Quaternion;
+}
+
+/**
+ * The rig handed to the bake is the live avatar, and the bake poses it.
+ */
+function capturePose(root: Object3D): CapturedBone[] {
+  const pose: CapturedBone[] = [];
+  root.traverse((object) => {
+    pose.push({
+      object,
+      position: object.position.clone(),
+      quaternion: object.quaternion.clone(),
+    });
+  });
+  return pose;
+}
+
+function restorePose(pose: CapturedBone[]): void {
+  for (const entry of pose) {
+    entry.object.position.copy(entry.position);
+    entry.object.quaternion.copy(entry.quaternion);
+  }
+}
