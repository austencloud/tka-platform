+const TRIQUETRA2_GRIP_OFFSET = 0.22468;
+function trace(target, contour, scale, place) {
+  const sy = place.mirror ? -scale : scale;
+  const shift = place.offset;
+  const px = (x) => x * scale;
+  const py = (y) => (y - shift) * sy;
+  target.moveTo(px(contour.start[0]), py(contour.start[1]));
