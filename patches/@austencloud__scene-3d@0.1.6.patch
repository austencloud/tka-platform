+    if (!toe) continue;
+    for (const object of [toe, ...toe.children]) {
+      object.getWorldPosition(point).applyMatrix4(toLocal);
+      lowest = Math.min(lowest, point.y);
+    }
+  }
+  return Number.isFinite(lowest) ? lowest : 0;
