+/**
+ * Prop Finish State
+ *
+ * Some props exist in two real builds: the fire one you burn and the day one
+ * you practise with. A triad is steel spines and kevlar wicks, or a printed hub
+ * and glow heads. Same prop, same reach, same notation — different object.
+ *
+ * That is a display preference, not a notation change, so it lives here as one
+ * reactive setting rather than as a second `PropType`. Prop components read it
+ * and pick their build; nothing about the sequence changes.
+ */
+
+import { PropType } from "../domain/enums/PropType";
+
+export type PropFinish = "fire" | "day";
+
+class PropFinishState {
+  private _finish = $state<PropFinish>("fire");
+
+  get finish(): PropFinish {
+    return this._finish;
+  }
+
+  set(finish: PropFinish): void {
+    this._finish = finish;
+  }
+
+  toggle(): void {
+    this._finish = this._finish === "fire" ? "day" : "fire";
+  }
+}
+
+export const propFinishState = new PropFinishState();
+
+/**
+ * The props Prop3D actually builds twice. Everything else ignores the finish,
+ * so a Fire/Day control shown next to them is a switch wired to nothing --
+ * surfaces ask this before offering the choice.
+ *
+ * A fire double staff and an LED baton are NOT on this list: those are separate
+ * objects with their own reach and their own notation entry, not two builds of
+ * one prop.
+ */
+const PROPS_WITH_FINISH_VARIANTS: ReadonlySet<PropType> = new Set([
+	PropType.TRIAD,
+	PropType.BIGTRIAD,
+	PropType.QUIAD,
+]);
+
+export function propHasFinishVariants(propType: PropType): boolean {
+	return PROPS_WITH_FINISH_VARIANTS.has(propType);
+}
