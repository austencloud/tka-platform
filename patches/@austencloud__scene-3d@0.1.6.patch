+/** Measure first, then solve. That makes the constraint non-causal and cyclic. */
+function measureLegClearance(
+  clip: AnimationClip,
+  footprint: ClipFootprint,
+  root: Object3D,
+  rig: Rig,
+  sides: Side[],
+  minimumShare: number
+): Float32Array {
