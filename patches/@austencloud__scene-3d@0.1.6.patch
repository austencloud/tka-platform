+    // pelvis track leaves zero and a clip with one writes only its own motion,
+    // then the rig's height added under whichever it was.
+    rig.hips.position.set(0, 0, 0);
+    mixer.setTime(i * step);
+    const travelX = rig.hips.position.x;
+    const travelZ = rig.hips.position.z;
+    rig.hips.position.add(rig.hipsRest);
+    // Ride at the height the walk rides at rather than the height the rig
+    // stands at. Travel across the floor stays with the track that had it.
+    rig.hips.position.y = rig.floor + footprint.hips[i]! * rig.legLength;
+    root.updateMatrixWorld(true);
+    alignPelvis(rig, sides, i);
+    root.updateMatrixWorld(true);
+    hipsValues[i * 3] = travelX;
+    hipsValues[i * 3 + 1] = rig.hips.position.y - rig.hipsRest.y;
+    hipsValues[i * 3 + 2] = travelZ;
