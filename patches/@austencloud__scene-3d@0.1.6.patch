+  rig.hips.position.set(0, 0, 0);
+  mixer.setTime(time);
+  rig.hips.position.add(rig.hipsRest);
+  rig.hips.position.y = rig.floor + hipsHeight * rig.legLength;
+  rig.frame.updateMatrixWorld(true);
+  alignPelvis(rig, sides, index);
+  rootUpdate(rig);
