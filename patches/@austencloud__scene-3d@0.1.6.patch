+    const wantFlat = Math.sqrt(Math.max(0, reach * reach - wantY * wantY));
+    const spread = flat > 1e-9 ? wantFlat / flat : 0;
+    armWants.set(armWas.x * spread, wantY, armWas.z * spread);
+    if (armWants.lengthSq() < 1e-12) return;
