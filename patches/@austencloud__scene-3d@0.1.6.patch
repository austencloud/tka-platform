+
+interface Side {
+  chain: BoneChain;
+  toe: Object3D | null;
+  hinge: Vector3;
+  track: FootTrack;
+  /** Last trustworthy bend branch in this sequential clip bake. */
+  bendSign?: -1 | 1;
+}
+
