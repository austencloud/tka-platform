+/**
+ * Parse a GLTF URL once for the lifetime of the page.
+ *
+ * Performer rigs frequently use the same avatar and locomotion files. Browser
+ * caching avoids another download, but GLTFLoader would still parse the same
+ * binary again for every performer. Keeping the parsed result here removes
+ * that repeated main-thread work. A failed request is evicted so retry still
+ * works after a temporary network problem.
+ */
+export function loadSharedGltf(url) {
+    const existing = loads.get(url);
+    if (existing)
+        return existing;
+    const pending = loader.loadAsync(url).then(async (gltf) => {
+        await fitAvatarTexturesToDisplayBudget(gltf.scene);
+        const box = new Box3().setFromObject(gltf.scene);
+        avatarBounds.set(url, {
+            height: box.max.y - box.min.y,
+            minY: box.min.y,
+        });
+        return gltf;
+    });
+    loads.set(url, pending);
+    void pending.catch(() => {
+        if (loads.get(url) === pending)
+            loads.delete(url);
+    });
+    return pending;
+}
+/**
+ * The authored character GLBs include desktop-production 4K PNGs. A single
+ * avatar can otherwise allocate hundreds of megabytes and block the WebGL
+ * driver for several frames when selected. Resize those decoded images once,
+ * before any instance reaches the renderer. The shared textures and all later
+ * clones retain the same color-space and material configuration.
+ */
+async function fitAvatarTexturesToDisplayBudget(root) {
+    if (typeof createImageBitmap !== "function")
+        return;
+    const texturesByImage = new Map();
+    for (const texture of collectTextures(root)) {
+        const image = texture.image;
+        if (!image)
+            continue;
+        const siblings = texturesByImage.get(image);
+        if (siblings)
+            siblings.push(texture);
+        else
+            texturesByImage.set(image, [texture]);
+    }
+    await Promise.all([...texturesByImage].map(async ([image, imageTextures]) => {
+        const source = image;
+        const width = source.width ?? source.naturalWidth ?? 0;
+        const height = source.height ?? source.naturalHeight ?? 0;
+        const largestDimension = Math.max(width, height);
+        if (largestDimension <= MAX_AVATAR_TEXTURE_DIMENSION)
+            return;
+        const scale = MAX_AVATAR_TEXTURE_DIMENSION / largestDimension;
+        const resized = await createImageBitmap(source, {
+            resizeWidth: Math.max(1, Math.round(width * scale)),
+            resizeHeight: Math.max(1, Math.round(height * scale)),
+            resizeQuality: "high",
+        });
+        for (const texture of imageTextures) {
+            texture.image = resized;
+            texture.needsUpdate = true;
+        }
+        source.close?.();
+    }));
