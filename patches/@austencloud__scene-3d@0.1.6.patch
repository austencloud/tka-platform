+    foot.getWorldQuaternion(footSpin);
+    footSpin.premultiply(pitchDelta);
+    if (foot.parent) {
+      foot.parent.getWorldQuaternion(parentSpin);
+      foot.quaternion.copy(parentSpin.invert()).multiply(footSpin);
+    } else {
