+  import { BufferGeometry, TorusGeometry } from "three";
+  import {
+    TRIAD_DAY,
+    TRIAD_FIRE,
+    TRIAD_PROP,
+    type TriadFrame,
+    type TriadSection,
+    type WickFrameProp,
+  } from "./triad-frame";
