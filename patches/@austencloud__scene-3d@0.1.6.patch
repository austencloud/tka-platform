+function smoothCircular(curve: Float32Array, rounds: number): void {
+  if (curve.length < 3) return;
+  const cycle = curve.length - 1;
+  const source = new Float32Array(curve.length);
+  for (let pass = 0; pass < rounds; pass++) {
+    source.set(curve);
+    for (let i = 0; i < cycle; i++)
+      curve[i] =
+        0.25 * source[(i - 1 + cycle) % cycle]! +
+        0.5 * source[i]! +
+        0.25 * source[(i + 1) % cycle]!;
+    curve[cycle] = curve[0]!;
