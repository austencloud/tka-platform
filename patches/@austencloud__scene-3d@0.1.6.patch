+      const largestDimension = Math.max(width, height);
+      if (largestDimension <= MAX_AVATAR_TEXTURE_DIMENSION) return;
+
+      const scale = MAX_AVATAR_TEXTURE_DIMENSION / largestDimension;
+      const resized = await createImageBitmap(source, {
+        resizeWidth: Math.max(1, Math.round(width * scale)),
+        resizeHeight: Math.max(1, Math.round(height * scale)),
+        resizeQuality: "high",
+      });
+      for (const texture of imageTextures) {
+        texture.image = resized;
+        texture.needsUpdate = true;
+      }
+      source.close?.();
+    })
+  );
+}
+
+function collectTextures(root: Object3D): Texture[] {
+  const textures = new Set<Texture>();
+  root.traverse((child) => {
+    const mesh = child as Mesh;
+    if (!mesh.material) return;
+    const materials = Array.isArray(mesh.material)
+      ? mesh.material
+      : [mesh.material];
+    for (const material of materials) {
+      for (const value of Object.values(material)) {
+        if ((value as Texture | undefined)?.isTexture) {
+          textures.add(value as Texture);
+        }
+      }
+    }
+  });
+  return [...textures];
+}
+
+/**
+ * Parse an avatar before another performer needs it.
+ *
+ * The first visible performer starts this work. Later performers then clone
+ * the prepared scene instead of briefly showing a stand-in while the same
+ * model is parsed again.
+ */
+export function prepareSharedGltf(url: string): Promise<void> {
+  return loadSharedGltf(url).then(() => undefined);
+}
+
+/** Reuse source-pose bounds instead of traversing a prepared clone on click. */
+export function getSharedGltfBounds(
+  url: string
+): { height: number; minY: number } | null {
+  return avatarBounds.get(url) ?? null;
+}
+
+/**
+ * Register a live renderer that can prepare avatar shaders and textures on
+ * intent. Multiple Avatar3D instances in one canvas share one context.
+ */
+export function registerAvatarRenderWarmup(
+  renderer: WebGLRenderer,
+  scene: Scene,
+  getCamera: () => Camera | null
+): () => void {
+  const existing = avatarRenderContexts.get(renderer);
+  if (existing) {
+    existing.references++;
+    existing.getCamera = getCamera;
+  } else {
+    avatarRenderContexts.set(renderer, {
+      renderer,
+      scene,
+      getCamera,
+      references: 1,
+      warmups: new Map(),
+      preparedRoots: new Map(),
+      preparedUrls: new Set(),
+    });
+  }
+
+  return () => {
+    const context = avatarRenderContexts.get(renderer);
+    if (!context) return;
+    context.references--;
+    if (context.references > 0) return;
+    for (const root of context.preparedRoots.values()) {
+      disposeWarmAvatarRoot(root);
+    }
+    avatarRenderContexts.delete(renderer);
+  };
+}
+
+function disposeWarmAvatarRoot(root: Object3D): void {
+  const skeletons = new Set<Skeleton>();
+  root.traverse((child) => {
+    const mesh = child as Mesh & { skeleton?: Skeleton };
+    if (mesh.skeleton) skeletons.add(mesh.skeleton);
+    if (!mesh.material) return;
+    if (Array.isArray(mesh.material)) {
+      mesh.material.forEach((material) => material.dispose());
+    } else {
+      mesh.material.dispose();
+    }
+  });
+  skeletons.forEach((skeleton) => skeleton.dispose());
+}
+
+async function warmAvatarForRenderer(
+  context: AvatarRenderWarmupContext,
+  root: Object3D,
+  label: string
+): Promise<void> {
+  const camera = context.getCamera();
+  if (!camera) return;
+
+  const compileStart = performance.now();
+  await context.renderer.compileAsync(root, camera, context.scene);
+  recordAvatarLoadSpan(label, "intent-shader-compile", compileStart);
+
+  // Upload one decoded texture per painted frame. WebGLRenderer.initTexture()
+  // leaves the live framebuffer, viewport, and scene untouched, so moving
+  // across avatar choices cannot flash a one-pixel target onto the stage.
+  const uploadStart = performance.now();
+  const textures = collectTextures(root);
+  for (const texture of textures) {
+    context.renderer.initTexture(texture);
+    await yieldToNextFrame();
+  }
+  recordAvatarLoadSpan(
+    label,
+    "intent-texture-upload",
+    uploadStart,
+    `${textures.length} textures`
+  );
+}
+
+/**
+ * Parse and upload an avatar when pointer or keyboard intent is known.
+ * Failed hints are evicted so the normal visible load can still retry.
+ */
+export async function prepareAvatarForDisplay(url: string): Promise<void> {
+  const gltf = await loadSharedGltf(url);
+  await Promise.all(
+    [...avatarRenderContexts.values()].map((context) => {
+      const existing = context.warmups.get(url);
+      if (existing) return existing;
+
+      const preparedRoot = cloneSharedSkinnedScene(gltf.scene);
+      preparedRoot.traverse((child) => {
+        const mesh = child as Mesh;
+        if (mesh.isMesh) mesh.castShadow = true;
+      });
+      const pending = warmAvatarForRenderer(
+        context,
+        preparedRoot,
+        avatarAssetLabel(url)
+      )
+        .then(() => {
+          context.preparedRoots.set(url, preparedRoot);
+          context.preparedUrls.add(url);
+        })
+        .catch((error) => {
+          if (context.warmups.get(url) === pending) {
+            context.warmups.delete(url);
+            context.preparedRoots.delete(url);
+            disposeWarmAvatarRoot(preparedRoot);
+          }
+          throw error;
+        });
+      context.warmups.set(url, pending);
+      return pending;
+    })
+  );
+}
+
+/** Whether a URL's shaders and shared textures are ready for this renderer. */
+export function isAvatarPreparedForRenderer(
+  url: string,
+  renderer: WebGLRenderer
+): boolean {
+  return avatarRenderContexts.get(renderer)?.preparedUrls.has(url) ?? false;
+}
+
+/** Transfer a completed intent warmup to the avatar instance that requested it. */
+export function takePreparedAvatarRoot(
+  url: string,
+  renderer?: WebGLRenderer
+): Object3D | null {
+  const contexts = renderer
+    ? [avatarRenderContexts.get(renderer)].filter(
+        (context): context is AvatarRenderWarmupContext => Boolean(context)
+      )
+    : [...avatarRenderContexts.values()];
+  for (const context of contexts) {
+    const root = context.preparedRoots.get(url);
+    if (!root) continue;
+    context.preparedRoots.delete(url);
+    return root;
+  }
+  return null;
+}
+
+/**
+ * Parse an animation GLB once without retaining the file's embedded scene.
+ *
+ * Mixamo animation exports often include a complete character alongside the
+ * clip. Keeping the entire GLTF for every locomotion asset costs hundreds of
+ * megabytes. This cache retains only the immutable AnimationClip shared by
+ * every performer and lets the unused scene graph be collected.
+ */
+export function loadSharedAnimation(url: string): Promise<AnimationClip> {
+  const existing = animationLoads.get(url);
+  if (existing) return existing;
+
+  const pending = loader.loadAsync(url).then((gltf) => {
+    const clip = gltf.animations[0];
+    if (!clip) throw new Error(`No animation in ${url}`);
+    return clip;
+  });
+  animationLoads.set(url, pending);
+  void pending.catch(() => {
+    if (animationLoads.get(url) === pending) animationLoads.delete(url);
+  });
+  return pending;
+}
+
+/** Share existence probes used before optional animation packs are loaded. */
+export function checkSharedAssetAvailability(url: string): Promise<boolean> {
+  const existing = availabilityChecks.get(url);
+  if (existing) return existing;
+
+  const pending = fetch(url, { method: "HEAD" }).then((response) => {
+    const contentType = response.headers.get("content-type") ?? "";
+    return response.ok && !contentType.includes("text/html");
+  });
+  availabilityChecks.set(url, pending);
+  void pending.catch(() => {
+    if (availabilityChecks.get(url) === pending) availabilityChecks.delete(url);
+  });
+  return pending;
+}
+
+/**
+ * Spread independent performer setup across frames in mount order.
+ *
+ * Svelte mounts every new rig synchronously. Serializing the heavy clone and
+ * mixer setup keeps a batch add from becoming one long main-thread task while
+ * the light state change and formation motion remain immediate.
+ */
+let performerInitializationQueue: Promise<void> = Promise.resolve();
+
+export async function schedulePerformerInitialization<T>(
+  initialize: () => Promise<T>,
+  label = "performer"
+): Promise<T> {
+  const predecessor = performerInitializationQueue;
+  let release!: () => void;
+  performerInitializationQueue = new Promise<void>((resolve) => {
+    release = resolve;
+  });
+
+  try {
+    const queuedAt = performance.now();
+    await predecessor;
+    recordAvatarLoadSpan(label, "init-queue-wait", queuedAt);
+    const yieldStart = performance.now();
+    await yieldUntilAfterPaint();
+    recordAvatarLoadSpan(label, "init-paint-yield", yieldStart);
+    const workStart = performance.now();
+    try {
+      return await initialize();
+    } finally {
+      recordAvatarLoadSpan(label, "init-work", workStart);
+    }
+  } finally {
+    release();
+  }
+}
+
+/**
+ * Mount one expensive performer subtree after the browser has painted.
+ *
+ * The callback is intentionally synchronous: it only opens a Svelte render
+ * gate. Avatar parsing has its own async initialization queue above. Keeping
+ * these queues separate prevents a network request from delaying the next
+ * performer's lightweight shell while still limiting WebGL setup to one
+ * subtree per painted frame.
+ */
+let performerMountQueue: Promise<void> = Promise.resolve();
+
+export async function schedulePerformerMount(
+  mount: () => void,
+  label = "performer"
+): Promise<void> {
+  const predecessor = performerMountQueue;
+  let release!: () => void;
+  performerMountQueue = new Promise<void>((resolve) => {
+    release = resolve;
+  });
+
+  try {
+    const queuedAt = performance.now();
+    await predecessor;
+    recordAvatarLoadSpan(label, "mount-queue-wait", queuedAt);
+    const yieldStart = performance.now();
+    await yieldUntilAfterPaint();
+    recordAvatarLoadSpan(label, "mount-paint-yield", yieldStart);
+    mount();
+  } finally {
+    release();
+  }
+}
+
+/**
+ * Give one performer an independently animatable skeleton while sharing the
+ * immutable geometry and textures from the parsed model. Materials are cloned
+ * because performer fades and customization mutate opacity and color.
+ */
+export function cloneSharedSkinnedScene(source: Object3D): Object3D {
+  const scene = cloneSkinned(source);
+  scene.traverse((child) => {
+    const mesh = child as Mesh;
+    if (!mesh.isMesh || !mesh.material) return;
+
+    mesh.material = Array.isArray(mesh.material)
+      ? mesh.material.map((material) => material.clone())
+      : (mesh.material as Material).clone();
+  });
+  return scene;
+}
+
+/** Test-only reset for proving retry and deduplication behavior. */
+export function clearSharedGltfCache(): void {
+  loads.clear();
+  animationLoads.clear();
+  availabilityChecks.clear();
+  performerInitializationQueue = Promise.resolve();
+  performerMountQueue = Promise.resolve();
+  for (const context of avatarRenderContexts.values()) {
+    context.warmups.clear();
+    for (const root of context.preparedRoots.values()) {
+      disposeWarmAvatarRoot(root);
+    }
+    context.preparedRoots.clear();
+  }
+}
