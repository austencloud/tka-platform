rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ============================================================================
    // HELPER FUNCTIONS
    // ============================================================================

    // Check if user has admin role via custom claims
    // Custom claims are set by Cloud Functions (syncSubscriptionRole)
    function isAdmin() {
      return request.auth != null && request.auth.token.role == 'admin';
    }

    // ============================================================================
    // USER DATA COLLECTIONS
    // ============================================================================

    // ML Training data - users can only access their own data
    match /ml-training/{userId}/{allPaths=**} {
      // Allow authenticated users to read/write their own training data
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Feedback staging - temporary uploads before feedback submission.
    // A feedback-doc onCreate trigger (promoteFeedbackImages) copies these to the
    // permanent feedback/ path; a scheduled Cloud Function cleans up orphans after
    // 30 minutes.
    match /feedback-staging/{userId}/{allPaths=**} {
      // Owner can read/write, admins can read (for feedback review)
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      // Owner can upload — images only, capped at 10MB (abuse guard; the client
      // also caps attachments at 5 per feedback).
      allow write: if request.auth != null && request.auth.uid == userId
        && (request.resource == null
          || (request.resource.contentType.matches('image/.*')
            && request.resource.size < 10 * 1024 * 1024));
    }

    // Feedback images - users can only access their own, admins can access all
    // Path structure: feedback/{userId}/{feedbackId}/{filename}
    // Security fix: Previously any authenticated user could read any feedback image
    match /feedback/{userId}/{feedbackId}/{allPaths=**} {
      // Only the owner or admin can read feedback images (may contain sensitive screenshots)
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      // Only the owner can upload their own feedback images
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Legacy feedback path (backwards compatibility for existing images)
    // TODO: Migrate existing images to new path structure, then remove this rule
    match /feedback/{feedbackId}/{allPaths=**} {
      // Only admins can read legacy feedback images (tightened from "any authenticated user")
      allow read: if isAdmin();
      // No new writes to legacy path
      allow write: if false;
    }

    // User recordings - users can only access their own recordings
    match /users/{userId}/recordings/{allPaths=**} {
      // Allow authenticated users to read/write their own recordings
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // User thumbnails - users can write their own, anyone can read (for public library)
    match /users/{userId}/thumbnails/{allPaths=**} {
      // Owner can write their own thumbnails
      allow write: if request.auth != null && request.auth.uid == userId;
      // Anyone can read thumbnails (for public sequence display)
      allow read: if true;
    }

    // User animations - users can write their own, anyone can read (for public library)
    match /users/{userId}/animations/{allPaths=**} {
      // Owner can write their own animations
      allow write: if request.auth != null && request.auth.uid == userId;
      // Anyone can read animations (for public sequence display)
      allow read: if true;
    }

    // User audio files - users can only access their own audio
    match /users/{userId}/audio/{allPaths=**} {
      // Allow authenticated users to read/write their own audio files
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // User avatars - generated profile pictures
    match /avatars/{userId}/{fileName} {
      // Owner can write their own avatars
      allow write: if request.auth != null && request.auth.uid == userId
        // Only allow PNG images
        && request.resource.contentType == 'image/png'
        // Limit file size to 1MB
        && request.resource.size < 1024 * 1024;
      // Anyone can read avatars (for displaying in profiles, comments, etc.)
      allow read: if true;
    }

    // Thumbnail manifest - public read for instant cache hits
    // Contains list of all existing thumbnails for pre-populating cache
    match /thumbnails/manifest.json {
      allow read: if true;
      // Only allow admin to update manifest (via admin script)
      // Uses custom claim when available, falls back to auth check
      allow write: if request.auth != null
        && (request.auth.token.admin == true || request.auth.token.role == 'admin');
    }

    // Crowd-sourced thumbnails - first user to view renders and uploads
    // New structure with variant: thumbnails/{variant}/{propType}/{sequenceName}_{mode}.webp
    // Variants: gallery (no user data), wordcard (with user data footer)
    match /thumbnails/{variant}/{propType}/{fileName} {
      // Anyone can read thumbnails (for fast loading)
      allow read: if true;
      // Authenticated users can upload thumbnails (crowd-sourced rendering)
      allow create, update: if request.auth != null
        // Only allow WebP images
        && request.resource.contentType == 'image/webp'
        // Limit file size to 500KB (thumbnails should be small)
        && request.resource.size < 500 * 1024;
      // Only admins can delete thumbnails (cache clearing)
      allow delete: if request.auth != null
        && (request.auth.token.admin == true || request.auth.token.role == 'admin');
    }

    // Shop cover-card renders — baked once by admin, read by everyone
    // Structure: shop-covers/{productId}/{index}.png
    match /shop-covers/{productId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && (request.auth.token.admin == true || request.auth.token.role == 'admin');
    }

    // Legacy thumbnails (backwards compatibility)
    // Old structure: thumbnails/{propType}/{sequenceName}_{mode}.webp
    match /thumbnails/{propType}/{fileName} {
      // Anyone can read thumbnails (for fast loading)
      allow read: if true;
      // Authenticated users can upload thumbnails (crowd-sourced rendering)
      allow create, update: if request.auth != null
        // Only allow WebP images
        && request.resource.contentType == 'image/webp'
        // Limit file size to 500KB (thumbnails should be small)
        && request.resource.size < 500 * 1024;
      // Only admins can delete thumbnails (cache clearing)
      allow delete: if request.auth != null
        && (request.auth.token.admin == true || request.auth.token.role == 'admin');
    }

    // POI image library - users upload POV pattern images in the POV Pattern Lab
    // and the binaries land here. Metadata doc lives at
    // /users/{uid}/poi-images/{id} in Firestore.
    match /users/{userId}/poi-images/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId
        // Limit to image types the lab actually accepts
        && (request.resource == null
          || request.resource.contentType.matches('image/(png|jpeg|bmp|webp)'))
        // Cap at 10MB — POV images are typically much smaller
        && (request.resource == null || request.resource.size < 10 * 1024 * 1024);
    }

    // Screenshots - users can only access their own screenshots
    match /screenshots/{userId}/{allPaths=**} {
      // Owner can read/write their own screenshots
      allow read, write: if request.auth != null && request.auth.uid == userId
        // Only allow PNG images
        && (request.resource == null || request.resource.contentType == 'image/png')
        // Limit file size to 10MB
        && (request.resource == null || request.resource.size < 10 * 1024 * 1024);
    }

    // Default: deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
