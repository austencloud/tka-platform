{
  "rules": {
    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid == $uid || auth.token.admin == true)"
      }
    },

    "gallery-sessions": {
      ".read": "auth != null",

      "$sessionId": {
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && (!data.exists() || data.child('hostId').val() == auth.uid)"
        },

        "players": {
          ".read": "auth != null",

          "$playerId": {
            ".write": "auth != null && auth.uid == $playerId",
            ".validate": "newData.hasChildren(['userId', 'displayName', 'position', 'rotation', 'status', 'lastUpdate'])"
          }
        },

        "chat": {
          ".read": "auth != null",

          "$messageId": {
            ".write": "auth != null && root.child('gallery-sessions').child($sessionId).child('players').child(auth.uid).exists()",
            ".validate": "newData.hasChildren(['userId', 'text', 'type', 'timestamp']) && newData.child('userId').val() == auth.uid"
          }
        }
      }
    }
  }
}
