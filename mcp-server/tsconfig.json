{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "$lib/*": ["../src/lib/*"]
    },
    "outDir": "./dist",
    "declaration": true,
    "declarationDir": "./dist",
    "noEmit": false,
    "rootDir": ".."
  },
  "include": [
    "index.ts",
    "src/**/*.ts",
    "test-loop.ts",
    "../src/lib/shared/render/core/**/*.ts",
    "../src/lib/shared/sequence-engine/data/contracts/ISequenceDataProvider.ts",
    "../src/lib/shared/sequence-engine/domain/models/SequenceEngineTypes.ts",
    "../src/lib/shared/sequence-engine/services/contracts/ITransitionGraph.ts",
    "../src/lib/shared/sequence-engine/services/implementations/TransitionGraph.ts"
  ],
  "exclude": ["node_modules"]
}
